---
layout: base.njk
title: About
permalink: /about/index.html
---

<div class="p-4 sm:p-8 space-y-6 sm:space-y-8">
  
  <header class="pb-5 sm:pb-6 border-b border-dotted border-base-300">
    <h1 class="font-heading text-2xl xs:text-3xl sm:text-4xl text-base-content font-bold tracking-tight">
      {{ about.title | default("About Me") }}
    </h1>
    <p class="text-xs sm:text-sm text-base-content/60 mt-1 font-sans">
      {{ about.subtitle | default("Background, engineering focus, and tools.") }}
    </p>
  </header>

  <div class="space-y-5 text-xs sm:text-sm text-base-content/80 leading-relaxed font-sans">
    <p>
      {{ (about.bio1 | default("I'm <strong>" ~ site.name ~ "</strong>, a software engineer and digital creator based in Bangalore, India. I specialize in building performant, accessible web systems, static architectures, and edge services.")) | safe }}
    </p>

    <p>
      {{ (about.bio2 | default("Over the last 4 years, I've engineered telemetry interfaces, design system token workflows, and full-stack applications. Alongside engineering, I share tutorials on YouTube (<strong>" ~ site.youtubeChannel.handle ~ "</strong>) with a community of over 45,000 developers.")) | safe }}
    </p>

    <!-- Experience -->
    <div class="pt-5 sm:pt-6 border-t border-dotted border-base-300">
      <h2 class="font-heading text-lg sm:text-xl font-semibold text-base-content mb-3 sm:mb-4">
        Experience
      </h2>
      <div class="space-y-4">
        {% for exp in resume.experience %}
          <div>
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-0.5 text-xs">
              <span class="font-medium text-base-content">{{ exp.position }} · {{ exp.company }}</span>
              <span class="text-base-content/50 font-mono text-[11px]">{{ exp.startDate }} — {{ exp.endDate }}</span>
            </div>
            {% if exp.highlights and exp.highlights[0] %}
              <p class="text-xs text-base-content/65 mt-1 font-sans">{{ exp.highlights[0] }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Workstation -->
    <div class="pt-5 sm:pt-6 border-t border-dotted border-base-300">
      <h2 class="font-heading text-lg sm:text-xl font-semibold text-base-content mb-3">
        Tools & Studio
      </h2>
      <ul class="text-xs text-base-content/70 space-y-1.5 list-disc list-inside font-sans">
        {% for tool in about.tools %}
          <li>{{ tool }}</li>
        {% else %}
          <li>MacBook Pro M3 Max · Dell UltraSharp 38" Curved</li>
          <li>Keychron Q1 Pro · Logitech MX Master 3S</li>
          <li>Sony A7IV · Shure SM7B · DaVinci Resolve Studio</li>
          <li>Cursor / VS Code · Ghostty Terminal · Figma</li>
        {% endfor %}
      </ul>
    </div>

    <div class="pt-5 sm:pt-6 border-t border-dotted border-base-300 flex flex-wrap items-center gap-3">
      <a href="/resume/" class="btn btn-neutral btn-sm rounded-lg px-4 text-xs font-normal font-mono">
        Resume
      </a>
      <a href="{{ site.youtubeChannel.url }}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm text-xs font-mono flex items-center gap-1.5">
        <i class="ph ph-youtube-logo text-base"></i> YouTube Channel <i class="ph ph-arrow-right text-[11px]"></i>
      </a>
    </div>

  </div>

</div>

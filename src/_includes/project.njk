---
layout: base.njk
---

<div class="relative w-full">
  
  <!-- =======================================================================
       01 // OUTSIDE LEFT SECTION NAVIGATION (TOC)
       Floating to the left outside the max-width column, vertically centered in viewport
       (Matching Reference Screenshot media_1793281174454_52e7e69e.png)
       ======================================================================= -->
  <aside class="hidden xl:block toc-fixed-left font-mono select-none pointer-events-auto" aria-label="Table of contents navigation">
    <nav id="toc-desktop-nav" class="space-y-1 max-h-[82vh] overflow-y-auto no-scrollbar py-2" aria-label="Table of contents">
      <!-- Dynamically populated by JS: Top, Context, Problem and opportunity, etc. -->
      <a href="#article-top" class="toc-item block py-1 text-xs font-mono text-primary font-semibold active" data-target="article-top">
        <span class="toc-label leading-snug break-words">Top</span>
      </a>
    </nav>
  </aside>

  <!-- =======================================================================
       02 // MAIN CONTENT COLUMN (Exact Same Max-Width as All Pages)
       ======================================================================= -->
  <div class="p-4 sm:p-8 space-y-5 sm:space-y-6">

    <!-- Top Action Bar (Back Arrow & Copy Link as in Reference Screenshot) -->
    <div id="article-top" class="flex items-center justify-between pb-4 sm:pb-5 border-b border-dotted border-base-300">
      <!-- Back to Projects Button -->
      <a 
        href="/projects/" 
        class="w-8 h-8 rounded-full bg-base-200/80 hover:bg-base-200 flex items-center justify-center text-base-content/70 hover:text-base-content transition-colors cursor-pointer"
        title="Back to all projects"
        aria-label="Back to all projects"
      >
        <i class="ph ph-arrow-left text-sm"></i>
      </a>

      <!-- Share / Copy Link Button -->
      <button 
        type="button" 
        onclick="copyPageLink(this)"
        class="w-8 h-8 rounded-full bg-base-200/80 hover:bg-base-200 flex items-center justify-center text-base-content/70 hover:text-base-content transition-colors cursor-pointer relative"
        title="Copy Link"
        aria-label="Copy page link"
      >
        <i class="ph ph-link text-sm"></i>
        <span class="copy-tooltip hidden absolute -bottom-7 right-0 text-[10px] font-mono px-2 py-0.5 rounded bg-base-content text-base-100 shadow whitespace-nowrap z-10 flex items-center gap-1">
          <i class="ph ph-check text-[10px]"></i> Link copied!
        </span>
      </button>
    </div>

    <!-- Case Study Header -->
    <header class="space-y-3 sm:space-y-4">
      <h1 class="font-heading text-2xl xs:text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-base-content leading-tight">
        {{ title }}
      </h1>

      <!-- Mobile/Tablet Sticky Section Quick-Jump (Placed directly beneath content heading) -->
      <div class="block xl:hidden sticky top-14 z-30 border border-dotted border-base-300 rounded-lg p-2 bg-base-100/95 backdrop-blur-md shadow-xs font-mono text-xs my-1">
        <details id="toc-mobile-dropdown" class="dropdown w-full relative">
          <summary class="flex items-center justify-between cursor-pointer text-base-content/75 select-none p-1">
            <span id="toc-mobile-current" class="truncate font-medium">Top</span>
            <span class="text-base-content/50 text-[10px] flex items-center gap-0.5">Jump to section <i class="ph ph-caret-down text-[10px]"></i></span>
          </summary>
          <ul id="toc-mobile-nav" class="dropdown-content menu p-2 mt-2 absolute left-0 right-0 w-full bg-base-100 rounded-xl border border-dotted border-base-300 shadow-xl z-50 space-y-1 max-h-64 overflow-y-auto">
            <!-- Populated by JS -->
          </ul>
        </details>
      </div>

      {% if description %}
        <p class="text-sm sm:text-lg text-base-content/75 leading-relaxed font-sans">
          {{ description | safe }}
        </p>
      {% endif %}

      <!-- Case Study Meta Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 pt-3 pb-4 border-y border-dotted border-base-300 text-xs font-mono">
        <div>
          <span class="text-base-content/40 block text-[10px] uppercase">Role</span>
          <span class="text-base-content/85">{{ role | default("Engineering & Design") }}</span>
        </div>
        <div>
          <span class="text-base-content/40 block text-[10px] uppercase">Timeline</span>
          <span class="text-base-content/85">{{ timeline | default(year) }}</span>
        </div>
        <div>
          <span class="text-base-content/40 block text-[10px] uppercase">Stack</span>
          <span class="text-base-content/85 truncate block">{{ tags | join(", ") }}</span>
        </div>
        <div>
          <span class="text-base-content/40 block text-[10px] uppercase">Links</span>
          <div class="flex items-center gap-2 pt-0.5">
            {% if link %}
              <a href="{{ link }}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline font-medium flex items-center gap-0.5">Demo <i class="ph ph-arrow-right text-[11px]"></i></a>
            {% endif %}
            {% if github %}
              <a href="{{ github }}" target="_blank" rel="noopener noreferrer" class="opacity-70 hover:opacity-100 flex items-center gap-0.5">Code <i class="ph ph-arrow-up-right text-[11px]"></i></a>
            {% endif %}
          </div>
        </div>
      </div>

      {% if image %}
        <div class="mt-4 overflow-hidden rounded-xl border border-dotted border-base-300 bg-base-200/30">
          <img src="{{ image }}" alt="{{ title }}" class="w-full h-auto max-h-[460px] object-cover cursor-zoom-in" loading="lazy">
        </div>
      {% endif %}
    </header>

    <!-- Case Study Content (Target for dynamic headings) -->
    <article id="article-content" class="prose prose-base sm:prose-lg max-w-none font-sans text-base-content/85 leading-relaxed pt-2">
      {{ content | safe }}
    </article>

    <!-- Footer Navigation -->
    <footer class="pt-8 border-t border-dotted border-base-300 flex items-center justify-between text-xs font-mono">
      <a href="/projects/" class="btn btn-outline btn-xs font-mono flex items-center gap-1 group">
        <i class="ph ph-arrow-left text-xs"></i> <span class="text-scramble" data-scramble="All work">All work</span>
      </a>
      <a href="#article-top" class="btn btn-ghost btn-xs font-mono flex items-center gap-1 group">
        <span class="text-scramble" data-scramble="Top">Top</span> <i class="ph ph-arrow-up text-xs"></i>
      </a>
    </footer>

  </div>

</div>

<script>
function copyPageLink(button) {
  const url = window.location.href;
  navigator.clipboard.writeText(url).then(() => {
    const tooltip = button.querySelector('.copy-tooltip');
    if (tooltip) {
      tooltip.classList.remove('hidden');
      setTimeout(() => tooltip.classList.add('hidden'), 2000);
    }
  });
}

document.addEventListener('DOMContentLoaded', () => {
  const contentArea = document.getElementById('article-content');
  const desktopNav = document.getElementById('toc-desktop-nav');
  const mobileNav = document.getElementById('toc-mobile-nav');
  const mobileLabel = document.getElementById('toc-mobile-current');
  if (!contentArea || (!desktopNav && !mobileNav)) return;

  // Extract main section headings (h2) matching reference screenshot
  const headings = Array.from(contentArea.querySelectorAll('h2'));
  if (headings.length === 0) return;

  const items = [{ id: 'article-top', text: 'Top' }];

  headings.forEach((heading, idx) => {
    let id = heading.id;
    if (!id) {
      id = heading.textContent
        .toLowerCase()
        .trim()
        .replace(/[^\w\s-]/g, '')
        .replace(/\s+/g, '-');
      if (!id) id = 'section-' + (idx + 1);
      heading.id = id;
    }
    heading.classList.add('scroll-mt-16');
    items.push({ id, text: heading.textContent.trim() });
  });

  if (desktopNav) {
    desktopNav.innerHTML = items.map((item, index) => `
      <a 
        href="#${item.id}" 
        class="toc-item block py-1 text-xs font-mono transition-colors duration-150 ${index === 0 ? 'text-primary font-semibold active' : 'text-base-content/40 hover:text-base-content/80'}"
        data-target="${item.id}"
      >
        <span class="toc-label leading-snug break-words">${item.text}</span>
      </a>
    `).join('');
  }

  if (mobileNav) {
    mobileNav.innerHTML = items.map((item, index) => `
      <li>
        <a 
          href="#${item.id}" 
          class="toc-mobile-link text-xs font-mono ${index === 0 ? 'text-primary font-semibold active' : ''}"
          data-target="${item.id}"
        >
          ${item.text}
        </a>
      </li>
    `).join('');
  }

  const allLinks = document.querySelectorAll('.toc-item, .toc-mobile-link');
  allLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('data-target');
      const targetElem = document.getElementById(targetId);

      // Close mobile dropdown first to maintain stable closed layout
      const mobileDetails = document.getElementById('toc-mobile-dropdown');
      if (mobileDetails) mobileDetails.removeAttribute('open');

      if (targetElem) {
        if (targetId === 'article-top') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          // Precise scroll landing: 56px navbar + 12px snug breathing room = 68px
          const headerOffset = 68;
          const elementPosition = targetElem.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
        history.pushState(null, '', '#' + targetId);
        updateActiveSection(targetId);
      }
    });
  });

  const updateActiveSection = (activeId) => {
    const desktopLinks = document.querySelectorAll('.toc-item');
    desktopLinks.forEach(link => {
      const isCurrent = link.getAttribute('data-target') === activeId;
      if (isCurrent) {
        link.classList.remove('text-base-content/40', 'font-normal');
        link.classList.add('text-primary', 'font-semibold', 'active');
      } else {
        link.classList.remove('text-primary', 'font-semibold', 'active');
        link.classList.add('text-base-content/40');
      }
    });

    const mobileLinks = document.querySelectorAll('.toc-mobile-link');
    mobileLinks.forEach(link => {
      const isCurrent = link.getAttribute('data-target') === activeId;
      if (isCurrent) {
        link.classList.add('active', 'text-primary', 'font-semibold');
      } else {
        link.classList.remove('active', 'text-primary', 'font-semibold');
      }
    });

    if (mobileLabel) {
      const matched = items.find(i => i.id === activeId);
      if (matched) mobileLabel.textContent = matched.text;
    }
  };

  const checkScrollPosition = () => {
    const scrollY = window.scrollY;
    const viewportHeight = window.innerHeight;
    const docHeight = document.documentElement.scrollHeight;
    
    // Bottom of page detection (within 120px buffer of bottom to guarantee last item glow)
    if ((scrollY + viewportHeight) >= (docHeight - 120) && items.length > 0) {
      updateActiveSection(items[items.length - 1].id);
      return true;
    }

    // Top of page detection
    if (scrollY < 60) {
      updateActiveSection('article-top');
      return true;
    }

    return false;
  };

  const observer = new IntersectionObserver((entries) => {
    if (checkScrollPosition()) return;

    const visibleEntries = entries.filter(e => e.isIntersecting);
    if (visibleEntries.length > 0) {
      const topVisible = visibleEntries.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      updateActiveSection(topVisible.target.id);
    } else {
      // Fallback: heading closest above viewport midpoint
      const viewportHeight = window.innerHeight;
      let currentId = 'article-top';
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= viewportHeight * 0.45) {
          currentId = h.id;
        } else {
          break;
        }
      }
      updateActiveSection(currentId);
    }
  }, {
    rootMargin: '-10% 0px -50% 0px',
    threshold: 0
  });

  const topAnchor = document.getElementById('article-top');
  if (topAnchor) observer.observe(topAnchor);
  headings.forEach(h => observer.observe(h));

  // High-performance scroll listener to guarantee bottom and top state activations
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        checkScrollPosition();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  // Connect images to lightbox
  const contentImages = contentArea.querySelectorAll('img');
  contentImages.forEach((img, index) => {
    img.addEventListener('click', () => {
      if (typeof openLightbox === 'function') {
        window.galleryImages = Array.from(contentImages).map(el => ({
          src: el.src,
          title: el.alt || 'Figure Illustration',
          desc: el.closest('div')?.querySelector('p')?.textContent?.trim() || '',
          meta: 'Case Study Graphic'
        }));
        openLightbox(index);
      }
    });
  });
});
</script>

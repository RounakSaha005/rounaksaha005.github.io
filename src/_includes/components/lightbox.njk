<!-- =======================================================================
     CINEMATIC MINIMAL LIGHTBOX MODAL
     Pure, unbounded image viewer with floating glass controls & crisp typography
     ======================================================================= -->
<dialog id="gallery-lightbox-modal" class="modal modal-bottom sm:modal-middle bg-black/95 backdrop-blur-2xl p-0 m-0 w-screen h-screen max-w-none max-h-none border-none select-none z-50">
  
  <div class="relative w-full h-full flex flex-col justify-between p-4 sm:p-6 overflow-hidden">
    
    <!-- ================= FLOATING MINIMAL TOP BAR ================= -->
    <header class="w-full flex items-center justify-between z-20 pointer-events-none shrink-0">
      
      <!-- Counter & Category Glass Pill -->
      <div class="flex items-center gap-2.5 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/10 text-white/80 font-mono text-xs pointer-events-auto shadow-sm">
        <span id="lb-counter" class="text-white/60 tracking-wider">1 / 6</span>
        <span class="w-1 h-1 rounded-full bg-white/30"></span>
        <span id="lb-category" class="text-white/90 font-medium tracking-wide">SETUP</span>
      </div>

      <!-- Action Controls: Expand original + Close -->
      <div class="flex items-center gap-2 pointer-events-auto">
        <a 
          id="lb-download" 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 text-white/70 hover:text-white flex items-center justify-center backdrop-blur-md transition-all active:scale-95 cursor-pointer shadow-sm" 
          title="Open original image in new tab"
          aria-label="Open original image"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <button 
          type="button" 
          onclick="closeLightbox()" 
          class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 text-white/80 hover:text-white flex items-center justify-center backdrop-blur-md transition-all active:scale-95 cursor-pointer shadow-sm" 
          title="Close (Esc)"
          aria-label="Close lightbox"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </header>

    <!-- ================= MAIN HERO IMAGE CANVAS ================= -->
    <div 
      class="relative flex-1 w-full flex items-center justify-center my-auto py-2 z-10 cursor-zoom-out" 
      onclick="if(event.target === this) closeLightbox();"
    >
      <!-- Floating Previous Arrow -->
      <button 
        type="button" 
        onclick="event.stopPropagation(); prevLightboxImage();" 
        class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white/10 hover:bg-white/25 active:scale-95 text-white/80 hover:text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg z-20 cursor-pointer"
        aria-label="Previous image"
        title="Previous (Left Arrow)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Centered Unbounded Image -->
      <img 
        id="lb-image" 
        src="" 
        alt="" 
        class="max-h-[70vh] sm:max-h-[74vh] max-w-[92vw] sm:max-w-[82vw] w-auto h-auto rounded-lg object-contain shadow-2xl transition-opacity duration-200 cursor-default"
        onclick="event.stopPropagation();"
      />

      <!-- Floating Next Arrow -->
      <button 
        type="button" 
        onclick="event.stopPropagation(); nextLightboxImage();" 
        class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white/10 hover:bg-white/25 active:scale-95 text-white/80 hover:text-white flex items-center justify-center backdrop-blur-md transition-all shadow-lg z-20 cursor-pointer"
        aria-label="Next image"
        title="Next (Right Arrow)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- ================= FLOATING MINIMAL BOTTOM CAPTION ================= -->
    <footer class="w-full flex justify-center z-20 pointer-events-none shrink-0">
      <div class="max-w-xl text-center space-y-1 pointer-events-auto px-5 py-2.5 rounded-xl bg-white/5 backdrop-blur-md border border-white/10 shadow-lg">
        <h3 id="lb-title" class="font-heading font-medium text-sm sm:text-base text-white/95 tracking-tight">
          Photo Title
        </h3>
        <p id="lb-desc" class="text-xs text-white/65 font-sans leading-relaxed line-clamp-2">
          Photo description
        </p>
        <span id="lb-meta" class="block text-[11px] font-mono text-white/40 pt-0.5">
          Bengaluru Studio · 2026
        </span>
      </div>
    </footer>

  </div>

  <!-- Native dialog backdrop click to close -->
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<!-- Embedded Photos JSON for Instant Client-Side Access -->
<script id="photos-data" type="application/json">
  {{ photos | dump | safe }}
</script>

<script>
  let currentLightboxIndex = 0;
  let cachedPhotos = null;

  function getPhotosList() {
    if (window.galleryImages && window.galleryImages.length > 0) {
      return window.galleryImages;
    }
    if (!cachedPhotos) {
      const dataElem = document.getElementById('photos-data');
      if (dataElem && dataElem.textContent) {
        try {
          cachedPhotos = JSON.parse(dataElem.textContent);
        } catch (e) {
          cachedPhotos = [];
        }
      } else {
        cachedPhotos = [];
      }
    }
    return cachedPhotos;
  }

  function openLightbox(index) {
    const list = getPhotosList();
    if (!list || list.length === 0) return;
    currentLightboxIndex = (index >= 0 && index < list.length) ? index : 0;
    updateLightboxContent();
    const modal = document.getElementById('gallery-lightbox-modal');
    if (modal) {
      modal.showModal();
      document.addEventListener('keydown', handleLightboxKeydown);
    }
  }

  function closeLightbox() {
    const modal = document.getElementById('gallery-lightbox-modal');
    if (modal) modal.close();
    document.removeEventListener('keydown', handleLightboxKeydown);
    window.galleryImages = null;
  }

  function prevLightboxImage() {
    const list = getPhotosList();
    if (!list || list.length === 0) return;
    currentLightboxIndex = (currentLightboxIndex - 1 + list.length) % list.length;
    updateLightboxContent();
  }

  function nextLightboxImage() {
    const list = getPhotosList();
    if (!list || list.length === 0) return;
    currentLightboxIndex = (currentLightboxIndex + 1) % list.length;
    updateLightboxContent();
  }

  function updateLightboxContent() {
    const list = getPhotosList();
    const photo = list[currentLightboxIndex];
    if (!photo) return;

    const img = document.getElementById('lb-image');
    const title = document.getElementById('lb-title');
    const desc = document.getElementById('lb-desc');
    const meta = document.getElementById('lb-meta');
    const category = document.getElementById('lb-category');
    const counter = document.getElementById('lb-counter');
    const download = document.getElementById('lb-download');

    if (img) {
      img.style.opacity = '0.3';
      img.src = photo.image;
      img.alt = photo.title || 'Gallery image';
      img.onload = () => { img.style.opacity = '1'; };
      setTimeout(() => { img.style.opacity = '1'; }, 100);
    }
    if (title) title.textContent = photo.title || '';
    if (desc) {
      if (photo.description) {
        desc.textContent = photo.description;
        desc.classList.remove('hidden');
      } else {
        desc.classList.add('hidden');
      }
    }
    if (meta) {
      const parts = [photo.location, photo.date].filter(Boolean);
      meta.textContent = parts.join(' · ');
      if (parts.length > 0) {
        meta.classList.remove('hidden');
      } else {
        meta.classList.add('hidden');
      }
    }
    if (category) category.textContent = (photo.category || 'Photo').toUpperCase();
    if (counter) counter.textContent = `${currentLightboxIndex + 1} / ${list.length}`;
    if (download) download.href = photo.image;
  }

  function handleLightboxKeydown(e) {
    if (e.key === 'ArrowLeft') {
      prevLightboxImage();
    } else if (e.key === 'ArrowRight') {
      nextLightboxImage();
    } else if (e.key === 'Escape') {
      closeLightbox();
    }
  }
</script>

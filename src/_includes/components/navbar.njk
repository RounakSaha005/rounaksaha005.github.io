<header class="sticky top-0 z-50 bg-base-100/90 backdrop-blur-md border-b border-base-200 shadow-xs">
  <div class="navbar max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Navbar Start: Brand & Mobile Menu -->
    <div class="navbar-start">
      <div class="dropdown lg:hidden">
        <label tabindex="0" class="btn btn-ghost btn-circle" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
          </svg>
        </label>
        <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-1 p-2 shadow-lg bg-base-200 rounded-box w-52 border border-base-300">
          {% for item in site.navigation %}
            <li>
              <a href="{{ item.url }}" class="{% if page.url == item.url %}active font-semibold{% endif %}">
                {{ item.label }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
      <a href="/" class="btn btn-ghost text-xl font-bold tracking-tight">
        {{ site.name }}
      </a>
    </div>

    <!-- Navbar Center: Desktop Navigation Links -->
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1 gap-1">
        {% for item in site.navigation %}
          <li>
            <a href="{{ item.url }}" class="rounded-lg {% if page.url == item.url %}active font-semibold{% endif %}">
              {{ item.label }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <!-- Navbar End: Theme Select Dropdown & Actions -->
    <div class="navbar-end gap-2">
      <!-- daisyUI select component with 4 themes -->
      <select
        id="theme-select"
        class="select select-bordered select-sm font-medium"
        aria-label="Choose Theme"
      >
        <option value="ocean-sun">Light - Ocean Sun</option>
        <option value="electric-pop">Light - Electric Pop</option>
        <option value="midnight-indigo">Dark - Midnight Indigo</option>
        <option value="slate-mint">Dark - Slate Mint</option>
      </select>

      <script>
        (function() {
          const select = document.getElementById('theme-select');
          if (!select) return;
          const currentTheme = document.documentElement.dataset.theme || 'ocean-sun';
          select.value = currentTheme;
          select.addEventListener('change', (e) => {
            const nextTheme = e.target.value;
            document.documentElement.dataset.theme = nextTheme;
            localStorage.setItem('theme', nextTheme);
          });
        })();
      </script>

      <!-- External Link / Social Icon -->
      {% if site.author.github %}
        <a href="{{ site.author.github }}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-circle" aria-label="GitHub">
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</header>

<header class="sticky top-0 z-50 bg-base-100/90 backdrop-blur-md border-b border-base-200/80 shadow-xs transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="navbar min-h-16 px-0 justify-between">
      
      <!-- ===================================================================
           Navbar Left: Brand Identity & Mobile Trigger
           =================================================================== -->
      <div class="navbar-start w-auto flex items-center gap-2">
        <!-- Mobile Dropdown Menu -->
        <div class="dropdown lg:hidden">
          <label tabindex="0" class="btn btn-ghost btn-circle btn-sm" aria-label="Open navigation menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
            </svg>
          </label>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-50 p-2 shadow-xl bg-base-100 rounded-box w-64 border border-base-200 divide-y divide-base-200">
            <div class="py-1">
              {% for item in site.navigation %}
                <li>
                  <a href="{{ item.url }}" class="flex items-center justify-between py-2 rounded-lg {% if page.url == item.url %}active font-semibold text-primary bg-base-200{% endif %}">
                    <span>{{ item.label }}</span>
                    {% if page.url == item.url %}
                      <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                    {% endif %}
                  </a>
                </li>
              {% endfor %}
            </div>
            <div class="pt-2 flex items-center justify-around">
              <a href="{{ site.author.linkedin }}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-circle btn-xs" aria-label="LinkedIn">
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
              <a href="{{ site.author.youtube }}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-circle btn-xs text-error" aria-label="YouTube">
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
              <a href="{{ site.author.github }}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-circle btn-xs" aria-label="GitHub">
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              </a>
            </div>
          </ul>
        </div>

        <!-- Brand Name with Monospace Prefix -->
        <a href="/" class="btn btn-ghost px-2 font-mono text-base sm:text-lg font-bold tracking-tight hover:bg-base-200">
          <span class="text-primary font-black">//</span> {{ site.name }}
          <span class="hidden sm:inline-block badge badge-xs badge-success badge-soft ml-1.5 font-sans font-normal py-2 px-2">
            <span class="w-1.5 h-1.5 rounded-full bg-success animate-pulse mr-1"></span> dev
          </span>
        </a>
      </div>

      <!-- ===================================================================
           Navbar Center: Navigation Links to Pages
           =================================================================== -->
      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal p-0 gap-1 text-sm font-medium">
          {% for item in site.navigation %}
            <li>
              <a 
                href="{{ item.url }}" 
                class="px-3 py-1.5 rounded-md transition-all duration-150 {% if page.url == item.url %}bg-base-200 text-primary font-semibold border-b-2 border-primary{% else %}hover:bg-base-200/70 hover:text-primary{% endif %}"
              >
                {{ item.label }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>

      <!-- ===================================================================
           Navbar Right: Social Links (LinkedIn, YouTube) & Theme Switcher
           =================================================================== -->
      <div class="navbar-end w-auto flex items-center gap-1 sm:gap-2">
        <!-- LinkedIn Link -->
        <a 
          href="{{ site.author.linkedin }}" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-ghost btn-circle btn-sm hover:text-primary" 
          title="LinkedIn Profile"
          aria-label="LinkedIn"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>

        <!-- YouTube Link (with subtle highlight) -->
        <a 
          href="{{ site.author.youtube }}" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-ghost btn-circle btn-sm hover:text-red-500" 
          title="YouTube Channel (@rounaksaha)"
          aria-label="YouTube Channel"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </a>

        <!-- GitHub Link -->
        <a 
          href="{{ site.author.github }}" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-ghost btn-circle btn-sm hidden sm:inline-flex hover:text-primary" 
          title="GitHub Profile"
          aria-label="GitHub"
        >
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>

        <!-- Vertical Divider -->
        <div class="h-4 w-px bg-base-300 mx-1 hidden sm:block"></div>

        <!-- 4-Theme Switcher Dropdown (daisyUI select) -->
        <select
          id="theme-select"
          class="select select-bordered select-xs sm:select-sm font-mono text-xs"
          aria-label="Select Color Theme"
        >
          <option value="ocean-sun">☀ Ocean Sun</option>
          <option value="electric-pop">⚡ Electric Pop</option>
          <option value="midnight-indigo">🌙 Midnight Indigo</option>
          <option value="slate-mint">🌿 Slate Mint</option>
        </select>
        <script>
          (function() {
            const select = document.getElementById('theme-select');
            if (!select) return;
            const currentTheme = document.documentElement.dataset.theme || 'ocean-sun';
            select.value = currentTheme;
            select.addEventListener('change', (e) => {
              const nextTheme = e.target.value;
              document.documentElement.dataset.theme = nextTheme;
              localStorage.setItem('theme', nextTheme);
            });
          })();
        </script>
      </div>

    </div>
  </div>
</header>

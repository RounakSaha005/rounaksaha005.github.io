<header class="site-navbar border-b border-dotted border-base-300 px-4 sm:px-8 py-3.5 sm:py-5">
  <div class="flex items-center justify-between gap-2">
    
    <!-- Left: Brand Identity with GSAP Rolling Text -->
    <a href="/" id="brand-link" class="group flex items-center shrink-0 cursor-pointer" aria-label="Rounak Saha Home">
      <span 
        id="brand-name-roll" 
        class="font-heading text-base sm:text-lg font-semibold text-base-content tracking-tight inline-flex overflow-hidden h-[1.3em] leading-[1.3em] select-none"
        aria-hidden="true"
      >
        Rounak Saha
      </span>
    </a>

    <!-- Center/Right: Clean Muted Navigation Links & Controls -->
    <div class="flex items-center gap-2 sm:gap-6">

      <!-- Desktop Navigation Links (visible on desktop sm and up, hidden on mobile) -->
      <nav class="max-sm:hidden flex items-center gap-3.5 sm:gap-6 text-xs text-base-content/75 font-mono">
        <a href="/" class="nav-scramble hover:text-base-content transition-colors {% if page.url == '/' %}text-base-content font-semibold{% endif %}" data-scramble="Home">
          Home
        </a>
        <a href="/projects/" class="nav-scramble hover:text-base-content transition-colors {% if page.url == '/projects/' %}text-base-content font-semibold{% endif %}" data-scramble="Work">
          Work
        </a>
        <a href="/blog/" class="nav-scramble hover:text-base-content transition-colors {% if page.url == '/blog/' %}text-base-content font-semibold{% endif %}" data-scramble="Notes">
          Notes
        </a>
        <a href="/photos/" class="nav-scramble hover:text-base-content transition-colors {% if page.url == '/photos/' %}text-base-content font-semibold{% endif %}" data-scramble="Art">
          Art
        </a>
        <a href="/about/" class="nav-scramble hover:text-base-content transition-colors {% if page.url == '/about/' %}text-base-content font-semibold{% endif %}" data-scramble="Info">
          Info
        </a>
      </nav>

      <!-- 1-Click Light / Dark Theme Toggle with Telegram-Style Growing Circle (daisyUI Swap-Rotate, visible on BOTH mobile and desktop) -->
      <button 
        id="theme-toggle-btn"
        type="button"
        class="swap swap-rotate p-1.5 rounded-lg text-base-content/60 hover:text-base-content hover:bg-base-200/60 transition-colors cursor-pointer shrink-0 focus-visible:outline-2 focus-visible:outline-primary"
        aria-label="Toggle Light and Dark Theme"
        title="Toggle Theme (Light / Dark)"
      >
        <!-- Sun icon (shown in dark mode - click to switch to light) -->
        <i class="swap-on ph ph-sun text-base"></i>
        
        <!-- Moon icon (shown in light mode - click to switch to dark) -->
        <i class="swap-off ph ph-moon text-base"></i>
      </button>

      <!-- Desktop Dropdown for secondary pages (Resume, Friends) - hidden on mobile -->
      <div class="dropdown dropdown-end max-sm:hidden">
        <label tabindex="0" class="cursor-pointer text-base-content/60 hover:text-base-content hover:bg-base-200/60 p-1.5 rounded-lg flex items-center justify-center transition-colors" aria-label="More navigation links">
          <i class="ph ph-dots-three-vertical text-base"></i>
        </label>
        <ul tabindex="0" class="dropdown-content menu p-1.5 shadow-xl bg-base-100 rounded-xl w-40 border border-dotted border-base-300 text-xs font-mono z-50 mt-2 space-y-0.5">
          <li>
            <a href="/resume/" class="flex items-center gap-2 py-2 px-2.5 rounded-lg hover:bg-base-200 hover:text-primary transition-colors">
              <i class="ph ph-file-text text-sm"></i> 
              <span class="nav-scramble" data-scramble="Resume / CV">Resume / CV</span>
            </a>
          </li>
          <li>
            <a href="/friends/" class="flex items-center gap-2 py-2 px-2.5 rounded-lg hover:bg-base-200 hover:text-primary transition-colors">
              <i class="ph ph-users text-sm"></i> 
              <span class="nav-scramble" data-scramble="Friends / Roll">Friends / Roll</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Mobile Hamburger Dropdown (visible only on mobile: sm:hidden) -->
      <div id="mobile-menu-dropdown" class="relative sm:hidden">
        <button 
          id="mobile-menu-trigger" 
          type="button"
          class="cursor-pointer text-base-content/75 hover:text-base-content hover:bg-base-200/60 p-1.5 rounded-lg flex items-center justify-center transition-colors focus-visible:outline-2 focus-visible:outline-primary relative z-50 pointer-events-auto" 
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="mobile-menu-dropdown-list"
        >
          <!-- Hamburger list icon (shown when menu closed) -->
          <i id="mobile-menu-open-icon" class="ph ph-list text-lg"></i>
          <!-- Close X icon (shown when menu open) -->
          <i id="mobile-menu-close-icon" class="ph ph-x text-lg hidden"></i>
        </button>

        <!-- Backdrop overlay when menu is open on mobile -->
        <div id="mobile-menu-backdrop" class="fixed inset-0 bg-black/25 backdrop-blur-xs z-40 hidden" aria-hidden="true"></div>

        <ul id="mobile-menu-dropdown-list" class="hidden absolute right-0 top-full mt-2 menu p-2 shadow-2xl bg-base-100 rounded-xl w-52 border border-dotted border-base-300 text-xs font-mono z-50 space-y-0.5">
          <li>
            <a href="/" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-base-200 transition-colors {% if page.url == '/' %}text-primary font-semibold bg-base-200/50{% endif %}">
              <i class="ph ph-house text-sm"></i>
              <span class="nav-scramble" data-scramble="Home">Home</span>
            </a>
          </li>
          <li>
            <a href="/projects/" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-base-200 transition-colors {% if page.url == '/projects/' %}text-primary font-semibold bg-base-200/50{% endif %}">
              <i class="ph ph-folder text-sm"></i>
              <span class="nav-scramble" data-scramble="Work">Work</span>
            </a>
          </li>
          <li>
            <a href="/blog/" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-base-200 transition-colors {% if page.url == '/blog/' %}text-primary font-semibold bg-base-200/50{% endif %}">
              <i class="ph ph-note-pencil text-sm"></i>
              <span class="nav-scramble" data-scramble="Notes">Notes</span>
            </a>
          </li>
          <li>
            <a href="/photos/" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-base-200 transition-colors {% if page.url == '/photos/' %}text-primary font-semibold bg-base-200/50{% endif %}">
              <i class="ph ph-image text-sm"></i>
              <span class="nav-scramble" data-scramble="Art">Art</span>
            </a>
          </li>
          <li>
            <a href="/about/" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-base-200 transition-colors {% if page.url == '/about/' %}text-primary font-semibold bg-base-200/50{% endif %}">
              <i class="ph ph-info text-sm"></i>
              <span class="nav-scramble" data-scramble="Info">Info</span>
            </a>
          </li>
          <li class="border-t border-dotted border-base-300 my-1"></li>
          <li>
            <a href="/resume/" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-base-200 transition-colors {% if page.url == '/resume/' %}text-primary font-semibold bg-base-200/50{% endif %}">
              <i class="ph ph-file-text text-sm"></i>
              <span class="nav-scramble" data-scramble="Resume / CV">Resume / CV</span>
            </a>
          </li>
          <li>
            <a href="/friends/" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-base-200 transition-colors {% if page.url == '/friends/' %}text-primary font-semibold bg-base-200/50{% endif %}">
              <i class="ph ph-users text-sm"></i>
              <span class="nav-scramble" data-scramble="Friends / Roll">Friends / Roll</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

  </div>
</header>

<script>
  (function() {
    // 1. Theme toggle synchronization with Telegram-style growing circle (View Transitions API)
    const themeBtn = document.getElementById('theme-toggle-btn');
    if (themeBtn) {
      let isTransitioning = false;

      function syncThemeButton() {
        const isDark = document.documentElement.dataset.theme === 'dark';
        themeBtn.classList.toggle('swap-active', isDark);
        themeBtn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
        themeBtn.setAttribute('title', isDark ? 'Switch to light theme' : 'Switch to dark theme');
      }

      function applyTheme(theme) {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem('theme', theme);
        syncThemeButton();
      }

      // Sync immediately
      syncThemeButton();

      themeBtn.addEventListener('click', function(e) {
        if (isTransitioning) return;

        const isDark = document.documentElement.dataset.theme === 'dark';
        const nextTheme = isDark ? 'light' : 'dark';

        // Check for reduced motion preference or lack of View Transitions API support
        if (!document.startViewTransition || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          applyTheme(nextTheme);
          return;
        }

        isTransitioning = true;

        // Calculate click / tap coordinates or fallback to button center
        const rect = themeBtn.getBoundingClientRect();
        const x = (e && typeof e.clientX === 'number' && e.clientX > 0)
          ? e.clientX
          : (rect.left + rect.width / 2);
        const y = (e && typeof e.clientY === 'number' && e.clientY > 0)
          ? e.clientY
          : (rect.top + rect.height / 2);

        // Maximum distance to the furthest viewport corner for 100% full-screen coverage
        const endRadius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        );

        const transition = document.startViewTransition(function() {
          applyTheme(nextTheme);
        });

        transition.ready.then(function() {
          const clipPath = [
            'circle(0px at ' + x + 'px ' + y + 'px)',
            'circle(' + endRadius + 'px at ' + x + 'px ' + y + 'px)'
          ];

          document.documentElement.animate(
            { clipPath: clipPath },
            {
              duration: 680,
              easing: 'cubic-bezier(0.32, 0, 0.16, 1)',
              pseudoElement: '::view-transition-new(root)'
            }
          );
        }).catch(function(err) {
          console.warn('View Transition animation fallback:', err);
        });

        transition.finished.finally(function() {
          isTransitioning = false;
        });
      });

      // Cross-tab synchronization
      window.addEventListener('storage', function(e) {
        if (e.key === 'theme' && (e.newValue === 'light' || e.newValue === 'dark')) {
          document.documentElement.dataset.theme = e.newValue;
          syncThemeButton();
        }
      });

      // Re-sync after DOM readiness
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', syncThemeButton);
      }
    }

    // 2. Mobile Hamburger Menu Toggle Controller
    const mobileDropdown = document.getElementById('mobile-menu-dropdown');
    const mobileTrigger = document.getElementById('mobile-menu-trigger');
    const mobileMenu = document.getElementById('mobile-menu-dropdown-list');
    const mobileBackdrop = document.getElementById('mobile-menu-backdrop');
    const mobileOpenIcon = document.getElementById('mobile-menu-open-icon');
    const mobileCloseIcon = document.getElementById('mobile-menu-close-icon');

    function setMobileMenuState(isOpen) {
      if (mobileTrigger) {
        mobileTrigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      }
      if (mobileMenu) {
        mobileMenu.classList.toggle('hidden', !isOpen);
      }
      if (mobileBackdrop) {
        mobileBackdrop.classList.toggle('hidden', !isOpen);
      }
      if (mobileOpenIcon) {
        mobileOpenIcon.classList.toggle('hidden', isOpen);
      }
      if (mobileCloseIcon) {
        mobileCloseIcon.classList.toggle('hidden', !isOpen);
      }
      if (!isOpen && document.activeElement && mobileDropdown && mobileDropdown.contains(document.activeElement)) {
        document.activeElement.blur();
      }
    }

    if (mobileTrigger && mobileMenu) {
      mobileTrigger.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const isCurrentlyOpen = !mobileMenu.classList.contains('hidden');
        setMobileMenuState(!isCurrentlyOpen);
      });

      if (mobileBackdrop) {
        mobileBackdrop.addEventListener('click', function(e) {
          e.preventDefault();
          setMobileMenuState(false);
        });
        mobileBackdrop.addEventListener('touchstart', function(e) {
          e.preventDefault();
          setMobileMenuState(false);
        }, { passive: false });
      }

      // Close when tapping/clicking anywhere outside the menu on mobile
      function handleOutsideInteraction(e) {
        if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
          if (mobileDropdown && !mobileDropdown.contains(e.target)) {
            setMobileMenuState(false);
          }
        }
      }
      document.addEventListener('pointerdown', handleOutsideInteraction);
      document.addEventListener('click', handleOutsideInteraction);

      // Close when pressing Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          setMobileMenuState(false);
        }
      });

      // Close when any link inside menu is clicked
      mobileMenu.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', function() {
          setMobileMenuState(false);
        });
      });

      // Close if window resized above mobile breakpoint (640px)
      window.addEventListener('resize', function() {
        if (window.innerWidth >= 640 && !mobileMenu.classList.contains('hidden')) {
          setMobileMenuState(false);
        }
      }, { passive: true });
    }

    // 3. GSAP Rolling Text Engine (Supports #brand-name-roll and any .text-roll element)
    function initRollingText() {
      function setupRoll(container, trigger, rawText) {
        if (!container || !trigger || container.dataset.rollReady) return;
        container.dataset.rollReady = "true";

        container.innerHTML = rawText.split('').map(function(char) {
          if (char === ' ') {
            return '<span class="inline-block w-[0.28em]">&nbsp;</span>';
          }
          return (
            '<span class="roll-col inline-block overflow-hidden h-[1.3em] leading-[1.3em] pointer-events-none">' +
              '<span class="roll-track inline-flex flex-col">' +
                '<span class="roll-char-top block h-[1.3em] leading-[1.3em] group-hover:text-primary transition-colors">' + char + '</span>' +
                '<span class="roll-char-bottom block h-[1.3em] leading-[1.3em] text-primary">' + char + '</span>' +
              '</span>' +
            '</span>'
          );
        }).join('');

        const tracks = container.querySelectorAll('.roll-track');
        let rollTween = null;

        trigger.addEventListener('mouseenter', function() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (typeof gsap === 'undefined') return;

          if (rollTween) rollTween.kill();
          rollTween = gsap.to(tracks, {
            y: '-50%',
            duration: 0.42,
            stagger: 0.02,
            ease: 'power3.inOut'
          });
        });

        trigger.addEventListener('mouseleave', function() {
          if (typeof gsap === 'undefined') return;
          if (rollTween) rollTween.kill();
          rollTween = gsap.to(tracks, {
            y: '0%',
            duration: 0.35,
            stagger: 0.012,
            ease: 'power3.out'
          });
        });
      }

      // Navbar brand
      const headerBrand = document.getElementById('brand-name-roll');
      const headerLink = document.getElementById('brand-link');
      if (headerBrand && headerLink) {
        setupRoll(headerBrand, headerLink, "Rounak Saha");
      }

      // Any other .text-roll elements (e.g. footer brand)
      document.querySelectorAll('.text-roll').forEach(function(el) {
        const trigger = el.closest('a, button, .group') || el;
        const text = el.getAttribute('data-roll') || el.textContent.trim();
        setupRoll(el, trigger, text);
      });
    }

    // 4. GSAP Text Scrambler Engine (Supports .nav-scramble and any .text-scramble element)
    function initTextScramble() {
      const elements = document.querySelectorAll('.nav-scramble, .text-scramble');
      const charset = "!<>-_\\/[]{}—=+*^?#01";

      elements.forEach(function(el) {
        if (el.dataset.scrambleReady) return;
        el.dataset.scrambleReady = "true";

        const originalText = el.getAttribute('data-scramble') || el.textContent.trim();
        el.setAttribute('data-scramble', originalText);
        const trigger = el.closest('a, button, .group') || el;

        let scrambleTween = null;

        trigger.addEventListener('mouseenter', function() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (typeof gsap === 'undefined') return;

          if (scrambleTween) scrambleTween.kill();

          const length = originalText.length;
          const state = { progress: 0 };

          scrambleTween = gsap.to(state, {
            progress: 1,
            duration: 0.36,
            ease: 'power2.out',
            onUpdate: function() {
              const solvedCount = Math.floor(state.progress * length);
              let scrambled = '';
              for (let i = 0; i < length; i++) {
                if (originalText[i] === ' ') {
                  scrambled += ' ';
                } else if (i < solvedCount) {
                  scrambled += originalText[i];
                } else {
                  scrambled += charset[Math.floor(Math.random() * charset.length)];
                }
              }
              el.textContent = scrambled;
            },
            onComplete: function() {
              el.textContent = originalText;
              scrambleTween = null;
            }
          });
        });

        trigger.addEventListener('mouseleave', function() {
          if (scrambleTween) {
            scrambleTween.kill();
            scrambleTween = null;
          }
          el.textContent = originalText;
        });
      });
    }

    // 5. Initialize GSAP animations once GSAP is ready
    function initCreativeEffects() {
      if (!window.gsap) {
        setTimeout(initCreativeEffects, 50);
        return;
      }
      initRollingText();
      initTextScramble();
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initCreativeEffects();
    } else {
      document.addEventListener('DOMContentLoaded', initCreativeEffects, { once: true });
    }
  })();
</script>

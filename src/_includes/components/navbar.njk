<header class="border-b border-dashed border-base-200/80 px-6 sm:px-8 py-5">
  <div class="flex items-center justify-between">
    
    <!-- Left: Bengali Script Identity (matching screenshot) -->
    <a href="/" class="group flex items-baseline gap-2" title="Rounak Saha">
      <span class="font-['Noto_Serif_Bengali',serif] text-2xl font-bold text-base-content tracking-tight">
        রৌনক
      </span>
      <span class="text-xs text-base-content/50 font-serif italic hidden sm:inline-block">
        / Rounak
      </span>
    </a>

    <!-- Center/Right: Clean Muted Navigation Links (Work, Art, Notes, Info style) -->
    <nav class="flex items-center gap-4 sm:gap-6 text-xs text-base-content/75 font-sans">
      <a href="/" class="hover:text-base-content transition-colors {% if page.url == '/' %}text-base-content font-semibold{% endif %}">
        Home
      </a>
      <a href="/projects/" class="hover:text-base-content transition-colors {% if page.url == '/projects/' %}text-base-content font-semibold{% endif %}">
        Work
      </a>
      <a href="/blog/" class="hover:text-base-content transition-colors {% if page.url == '/blog/' %}text-base-content font-semibold{% endif %}">
        Notes
      </a>
      <a href="/photos/" class="hover:text-base-content transition-colors {% if page.url == '/photos/' %}text-base-content font-semibold{% endif %}">
        Art
      </a>
      <a href="/about/" class="hover:text-base-content transition-colors {% if page.url == '/about/' %}text-base-content font-semibold{% endif %}">
        Info
      </a>

      <!-- Minimal Dropdown for other pages & themes -->
      <div class="dropdown dropdown-end">
        <label tabindex="0" class="cursor-pointer text-base-content/60 hover:text-base-content p-1" aria-label="More menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
          </svg>
        </label>
        <ul tabindex="0" class="dropdown-content menu p-2 shadow-lg bg-base-100 rounded-lg w-44 border border-base-200 text-xs z-50 mt-2">
          <li><a href="/resume/">Resume / CV</a></li>
          <li><a href="/friends/">Friends / Roll</a></li>
          <li class="menu-title mt-2 pt-2 border-t border-base-200 text-[10px] uppercase font-mono">Theme</li>
          <li><button type="button" onclick="setTheme('ocean-sun')">☀ Ocean Sun</button></li>
          <li><button type="button" onclick="setTheme('electric-pop')">⚡ Electric Pop</button></li>
          <li><button type="button" onclick="setTheme('midnight-indigo')">🌙 Midnight</button></li>
          <li><button type="button" onclick="setTheme('slate-mint')">🌿 Slate Mint</button></li>
        </ul>
      </div>

    </nav>

  </div>
</header>

<script>
  function setTheme(name) {
    document.documentElement.dataset.theme = name;
    localStorage.setItem('theme', name);
  }
</script>

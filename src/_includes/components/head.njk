<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
<meta name="description" content="{{ description | default(site.description) }}">
<meta name="author" content="{{ site.author.name }}">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="{% if page.url and page.url.startsWith('/posts/') and page.url != '/posts/' %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.title }}{% endif %}">
<meta property="og:description" content="{{ description | default(site.description) }}">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.title }}{% endif %}">
<meta name="twitter:description" content="{{ description | default(site.description) }}">

<!-- Social Sharing Image -->
{% if image %}
<meta property="og:image" content="{{ site.url }}{{ image }}">
<meta name="twitter:image" content="{{ site.url }}{{ image }}">
{% elif site.avatar %}
<meta property="og:image" content="{{ site.url }}{{ site.avatar }}">
<meta name="twitter:image" content="{{ site.url }}{{ site.avatar }}">
{% endif %}

<!-- Theme script to prevent FOUC (Flash of Unstyled Content) -->
<script>
  (function() {
    const saved = localStorage.getItem('theme');
    if (saved === 'dark' || saved === 'light') {
      document.documentElement.dataset.theme = saved;
    } else {
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = prefersDark ? 'dark' : 'light';
    }
  })();
</script>

<!-- Fonts: Mona Sans (Headings), Geist Mono (Code/Mono), Archivo (Body) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,100..900;1,100..900&family=Geist+Mono:wght@100..900&family=Mona+Sans:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet">

<!-- Compiled Tailwind CSS & daisyUI -->
<link rel="stylesheet" href="/styles/index.css">

<!-- GSAP Animation Engine -->
<script src="/assets/js/gsap.min.js" defer></script>
<script>
  window.addEventListener('error', function(e) {
    if (e.target && e.target.src && e.target.src.includes('gsap.min.js') && !window.gsap) {
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js';
      document.head.appendChild(s);
    }
  }, true);
</script>

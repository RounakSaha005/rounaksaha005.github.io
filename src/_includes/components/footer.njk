<footer class="border-t border-dotted border-base-300 p-4 sm:p-8 text-xs text-base-content/60 font-mono mt-auto">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
    <div class="flex items-center gap-2">
      <span class="font-heading text-sm text-base-content font-semibold">Rounak Saha</span>
      <span>·</span>
      <span>© {% year %}</span>
    </div>

    <div class="flex items-center gap-3.5 sm:gap-4 text-xs font-mono flex-wrap justify-center">
      <a href="{{ site.author.linkedin }}" target="_blank" rel="noopener noreferrer" class="hover:text-base-content transition-colors flex items-center gap-1"><i class="ph ph-linkedin-logo"></i> LinkedIn</a>
      <a href="{{ site.author.youtube }}" target="_blank" rel="noopener noreferrer" class="hover:text-base-content transition-colors flex items-center gap-1"><i class="ph ph-youtube-logo"></i> YouTube</a>
      <a href="{{ site.author.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-base-content transition-colors flex items-center gap-1"><i class="ph ph-github-logo"></i> GitHub</a>
      <a href="mailto:{{ site.author.email }}" class="hover:text-base-content transition-colors flex items-center gap-1"><i class="ph ph-envelope"></i> Email</a>
    </div>
  </div>
</footer>

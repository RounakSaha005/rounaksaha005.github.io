<footer class="border-t border-base-200/60 py-10 mt-auto text-xs text-base-content/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <span class="font-medium text-base-content">{{ site.name }}</span>
      <span>·</span>
      <span>Full-Stack Engineer & YouTuber</span>
      <span>·</span>
      <span>© {% year %}</span>
    </div>

    <div class="flex items-center gap-5">
      <a href="{{ site.author.linkedin }}" target="_blank" rel="noopener noreferrer" class="hover:text-base-content transition-colors">LinkedIn</a>
      <a href="{{ site.author.youtube }}" target="_blank" rel="noopener noreferrer" class="hover:text-base-content transition-colors">YouTube</a>
      <a href="{{ site.author.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-base-content transition-colors">GitHub</a>
      <a href="mailto:{{ site.author.email }}" class="hover:text-base-content transition-colors">Email</a>
    </div>
  </div>
</footer>

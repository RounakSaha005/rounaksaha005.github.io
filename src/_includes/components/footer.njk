<footer class="border-t border-dotted border-base-300 p-4 sm:p-8 text-xs text-base-content/60 font-mono mt-auto">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
    <div class="flex items-center gap-2">
      <a href="/" class="group flex items-center focus-visible:outline-2 focus-visible:outline-primary rounded" aria-label="Rounak Saha Home">
        <span class="text-roll font-heading text-sm text-base-content font-semibold" data-roll="Rounak Saha">Rounak Saha</span>
      </a>
      <span>·</span>
      <span>© {% year %}</span>
    </div>

    <div class="flex items-center gap-3.5 sm:gap-4 text-xs font-mono flex-wrap justify-center">
      <a href="{{ site.author.linkedin }}" target="_blank" rel="noopener noreferrer" class="hover:text-base-content transition-colors flex items-center gap-1"><i class="ph ph-linkedin-logo"></i> <span class="text-scramble" data-scramble="LinkedIn">LinkedIn</span></a>
      <a href="{{ site.author.youtube }}" target="_blank" rel="noopener noreferrer" class="hover:text-base-content transition-colors flex items-center gap-1"><i class="ph ph-youtube-logo"></i> <span class="text-scramble" data-scramble="YouTube">YouTube</span></a>
      <a href="{{ site.author.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-base-content transition-colors flex items-center gap-1"><i class="ph ph-github-logo"></i> <span class="text-scramble" data-scramble="GitHub">GitHub</span></a>
      <a href="mailto:{{ site.author.email }}" class="hover:text-base-content transition-colors flex items-center gap-1"><i class="ph ph-envelope"></i> <span class="text-scramble" data-scramble="Email">Email</span></a>
    </div>
  </div>
</footer>

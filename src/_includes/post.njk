---
layout: base.njk
---

<article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <!-- Back Link -->
  <div class="mb-8">
    <a href="/blog/" class="btn btn-ghost btn-sm pl-0 hover:bg-transparent hover:text-primary transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to all posts
    </a>
  </div>

  <!-- Article Header -->
  <header class="mb-10 pb-8 border-b border-dotted border-base-300">
    <!-- Tags -->
    {% if tags %}
      <div class="flex flex-wrap gap-2 mb-4">
        {% for tag in tags %}
          {% if tag != "posts" %}
            <span class="badge badge-outline badge-primary text-xs uppercase tracking-wider font-semibold">
              #{{ tag }}
            </span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight">
      {{ title }}
    </h1>

    {% if description %}
      <p class="mt-4 text-xl opacity-80 leading-relaxed font-sans">
        {{ description }}
      </p>
    {% endif %}

    <!-- Meta Details (Date, Author) -->
    <div class="mt-6 flex items-center gap-4 text-sm opacity-70 font-mono">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <time datetime="{{ page.date | htmlDateString }}">
          {{ page.date | readableDate }}
        </time>
      </div>

      <span>•</span>

      <span>{{ author | default(site.author.name) }}</span>
    </div>

    <!-- Featured Post Image -->
    {% if image %}
      <div class="mt-8 overflow-hidden rounded-box border border-dotted border-base-300 shadow-sm">
        <img src="{{ image }}" alt="{{ title }}" class="w-full h-auto max-h-[480px] object-cover" loading="lazy">
      </div>
    {% endif %}
  </header>

  <!-- Article Prose Content -->
  <div class="prose prose-lg max-w-none font-sans">
    {{ content | safe }}
  </div>

  <!-- Article Footer -->
  <footer class="mt-16 pt-8 border-t border-dotted border-base-300 flex justify-between items-center text-sm">
    <a href="/posts/" class="btn btn-outline btn-sm">
      ← View more posts
    </a>
    <a href="#main-content" class="btn btn-ghost btn-sm">
      Back to top ↑
    </a>
  </footer>
</article>

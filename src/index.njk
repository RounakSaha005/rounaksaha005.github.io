---
layout: base.njk
title: Home
---

<!-- =======================================================================
     01 // HERO SECTION (Image on Left, Text on Right with Buttons)
     ======================================================================= -->
<section class="py-14 sm:py-20 border-b border-base-200/60 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8 sm:gap-12">
      
      <!-- HERO LEFT: Image -->
      <div class="shrink-0">
        <div class="w-36 h-36 sm:w-48 sm:h-48 rounded-2xl overflow-hidden border border-base-200 bg-base-200/50 shadow-xs">
          <img 
            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=600&q=80" 
            alt="{{ site.name }}"
            class="w-full h-full object-cover object-center filter grayscale hover:grayscale-0 transition-all duration-300"
            loading="eager"
          />
        </div>
      </div>

      <!-- HERO RIGHT: Text & Buttons -->
      <div class="flex-1 text-center sm:text-left space-y-4">
        <div>
          <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-base-content">
            {{ site.name }}
          </h1>
          <p class="text-sm sm:text-base text-primary font-medium mt-1">
            {{ site.role }}
          </p>
        </div>

        <p class="text-sm sm:text-base text-base-content/80 leading-relaxed max-w-xl">
          {{ site.description }} I create developer tutorials and engineering walkthroughs for a community of 45K+ subscribers on YouTube.
        </p>

        <!-- Minimal Action Buttons -->
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 pt-2">
          <a href="#projects" class="btn btn-primary btn-sm">
            Projects
          </a>
          <a href="{{ site.author.youtube }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
            YouTube
          </a>
          <a href="/about/" class="btn btn-ghost btn-sm">
            About →
          </a>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- =======================================================================
     02 // INFINITE SCROLL (GSAP) WITH PROGRAMMING LANGUAGES
     ======================================================================= -->
<section class="py-4 border-b border-base-200/60 overflow-hidden bg-base-200/20">
  <div class="marquee-container">
    <div id="gsap-marquee-track" class="marquee-track flex items-center gap-6 text-xs text-base-content/75 font-mono cursor-pointer">
      
      <!-- Primary List -->
      {% for lang in languages %}
        <div class="flex items-center gap-2 shrink-0 py-1 px-2.5 rounded-md hover:text-base-content transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/70"></span>
          <span>{{ lang.name }}</span>
        </div>
      {% endfor %}

      <!-- Duplicate for Seamless Infinite Loop -->
      {% for lang in languages %}
        <div class="flex items-center gap-2 shrink-0 py-1 px-2.5 rounded-md hover:text-base-content transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/70"></span>
          <span>{{ lang.name }}</span>
        </div>
      {% endfor %}

    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const initGSAP = () => {
        if (!window.gsap) {
          setTimeout(initGSAP, 100);
          return;
        }
        const track = document.getElementById('gsap-marquee-track');
        if (!track) return;

        const halfWidth = track.scrollWidth / 2;
        const tween = gsap.to(track, {
          x: -halfWidth,
          duration: 28,
          ease: "none",
          repeat: -1,
          modifiers: {
            x: gsap.utils.unitize(x => parseFloat(x) % halfWidth)
          }
        });

        track.addEventListener('mouseenter', () => tween.pause());
        track.addEventListener('mouseleave', () => tween.resume());
      };
      initGSAP();
    });
  </script>
</section>


<!-- =======================================================================
     03 // PROJECTS
     ======================================================================= -->
<section id="projects" class="py-16 border-b border-base-200/60">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-base-content">Projects</h2>
        <p class="text-xs text-base-content/60 mt-0.5">Selected open source and web tools.</p>
      </div>
      <a href="/projects/" class="text-xs text-primary hover:underline">All projects →</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {% for project in projects | limit(4) %}
        <div class="p-5 rounded-xl border border-base-200/80 bg-base-100 hover:border-base-300 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-xs font-mono text-base-content/60 mb-2">
              <span>{{ project.year }}</span>
              <span>{{ project.status }}</span>
            </div>
            
            <h3 class="font-semibold text-base text-base-content">
              {{ project.title }}
            </h3>

            <p class="text-xs text-base-content/75 leading-relaxed mt-1.5">
              {{ project.description }}
            </p>
          </div>

          <div class="flex items-center justify-between pt-4 mt-4 border-t border-base-200/50 text-xs">
            <span class="text-base-content/50 font-mono">{{ project.tags | join(" · ") }}</span>
            <div class="flex gap-3">
              {% if project.github %}
                <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" class="hover:underline opacity-80">Code</a>
              {% endif %}
              {% if project.link %}
                <a href="{{ project.link }}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline font-medium">Demo →</a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>


<!-- =======================================================================
     04 // YOUTUBE VIDEOS (Featured by Creator)
     ======================================================================= -->
<section id="videos" class="py-16 border-b border-base-200/60">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-base-content">YouTube</h2>
        <p class="text-xs text-base-content/60 mt-0.5">Tutorials and system breakdowns · 45K subscribers.</p>
      </div>
      <a href="{{ site.youtubeChannel.url }}" target="_blank" rel="noopener noreferrer" class="text-xs text-primary hover:underline">Visit channel →</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {% for video in youtube | limit(2) %}
        <a 
          href="{{ video.url }}" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group block p-3 rounded-xl border border-base-200/80 bg-base-100 hover:border-base-300 transition-colors"
        >
          <div class="relative aspect-video rounded-lg overflow-hidden bg-base-200 mb-3">
            <img 
              src="{{ video.thumbnail }}" 
              alt="{{ video.title }}" 
              class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
              loading="lazy"
            />
            <span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded bg-black/80 text-white text-[10px] font-mono">
              {{ video.duration }}
            </span>
          </div>

          <h3 class="font-medium text-sm leading-snug group-hover:text-primary transition-colors">
            {{ video.title }}
          </h3>

          <p class="text-xs text-base-content/60 font-mono mt-2">
            {{ video.views }} · {{ video.published }}
          </p>
        </a>
      {% endfor %}
    </div>

  </div>
</section>


<!-- =======================================================================
     05 // BLOGS (Writing)
     ======================================================================= -->
<section id="blog" class="py-16 border-b border-base-200/60">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-base-content">Writing</h2>
        <p class="text-xs text-base-content/60 mt-0.5">Thoughts on software architecture and developer tools.</p>
      </div>
      <a href="/blog/" class="text-xs text-primary hover:underline">All posts →</a>
    </div>

    <div class="divide-y divide-base-200/60">
      {% for post in collections.posts | reverse | limit(3) %}
        <article class="py-4 first:pt-0 last:pb-0">
          <a href="{{ post.url }}" class="group flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <h3 class="text-sm sm:text-base font-medium group-hover:text-primary transition-colors">
              {{ post.data.title }}
            </h3>
            <time datetime="{{ post.date | htmlDateString }}" class="text-xs text-base-content/50 font-mono shrink-0">
              {{ post.date | readableDate }}
            </time>
          </a>
          <p class="text-xs text-base-content/70 mt-1 max-w-2xl leading-relaxed">
            {{ post.data.description | default(post.templateContent | striptags | truncate(120)) }}
          </p>
        </article>
      {% else %}
        <p class="text-xs text-base-content/50 font-mono py-4">No posts published yet.</p>
      {% endfor %}
    </div>

  </div>
</section>


<!-- =======================================================================
     06 // GALLERY (Photos)
     ======================================================================= -->
<section id="gallery" class="py-16 border-b border-base-200/60">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <div class="flex items-baseline justify-between mb-8">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-base-content">Photos</h2>
        <p class="text-xs text-base-content/60 mt-0.5">Workspaces, setups, and travels.</p>
      </div>
      <a href="/photos/" class="text-xs text-primary hover:underline">All photos →</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {% for photo in photos | limit(3) %}
        <figure class="group">
          <div class="aspect-4/3 rounded-xl overflow-hidden bg-base-200 border border-base-200/80">
            <img 
              src="{{ photo.image }}" 
              alt="{{ photo.title }}" 
              class="w-full h-full object-cover filter grayscale hover:grayscale-0 transition-all duration-300"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-2 text-xs text-base-content/70 truncate">
            {{ photo.title }}
          </figcaption>
        </figure>
      {% endfor %}
    </div>

  </div>
</section>


<!-- =======================================================================
     07 // CONTACT
     ======================================================================= -->
<section class="py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
    <div>
      <h2 class="text-lg font-bold tracking-tight text-base-content">Get in touch</h2>
      <p class="text-xs text-base-content/70 mt-1">
        Open for collaborations, contracts, and creator sponsorships.
      </p>
    </div>
    <div class="flex gap-3">
      <a href="mailto:{{ site.author.email }}" class="btn btn-primary btn-sm">
        Email Me
      </a>
      <a href="{{ site.author.linkedin }}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">
        LinkedIn
      </a>
    </div>
  </div>
</section>

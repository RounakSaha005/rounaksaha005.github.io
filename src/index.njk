---
layout: base.njk
title: Home
---

<!-- =======================================================================
     01 // HERO SECTION (Image on Left, Text on Right with Buttons)
     ======================================================================= -->
<section class="p-4 sm:p-8 border-b border-dotted border-base-300">
  <div class="flex flex-col sm:flex-row sm:items-stretch gap-4 sm:gap-6">
    
    <!-- Hero Left: Portrait Image (Matches full height of text block on desktop, square on mobile) -->
    <div class="w-20 h-20 xs:w-24 xs:h-24 sm:w-36 md:w-44 sm:h-auto shrink-0 self-start sm:self-stretch">
      <div class="w-full h-full aspect-square sm:aspect-auto rounded-2xl overflow-hidden border border-dotted border-base-300 bg-base-200/40 shadow-2xs">
        <img 
          src="/assets/images/me.jpeg" 
          alt="{{ site.name }}"
          class="w-full h-full object-cover filter grayscale hover:grayscale-0 transition-all duration-300"
          loading="eager"
        />
      </div>
    </div>

    <!-- Hero Right: Headline, Bio & Action Buttons -->
    <div class="flex-1 flex flex-col justify-between space-y-3.5">
      
      <div class="space-y-2">
        <!-- Main Headline (Mona Sans) -->
        <h1 class="font-heading text-xl xs:text-2xl sm:text-3xl md:text-4xl text-base-content font-bold tracking-tight leading-tight">
          {{ home.headline | default("Hello I'm Rounak Saha, engineer, craftsman") }}
        </h1>

        <!-- Bio / Description -->
        <p class="text-xs sm:text-sm text-base-content/75 leading-relaxed font-sans">
          {{ (home.bio | default("Full-stack engineer based out of Bangalore with <strong>4 years</strong> of experience, currently <strong>engineering modern web platforms at Vortex</strong> and teaching <strong>45K+ developers on YouTube</strong>.")) | safe }}
        </p>
      </div>

      <!-- Action Row (Pill Button + Fully Configurable & Static Hero Social Icons) -->
      <div class="flex items-center gap-2 pt-1 flex-wrap">
        <a 
          href="/resume/" 
          class="btn btn-neutral btn-sm rounded-lg px-3.5 sm:px-4 font-normal text-xs normal-case shadow-2xs font-mono group"
        >
          <span class="text-scramble" data-scramble="Download Resume">Download Resume</span>
        </a>

        {% set heroSocials = home.socialLinks if (home.socialLinks and home.socialLinks.length > 0) else site.socialLinks %}
        {% if heroSocials %}
          {% for item in heroSocials %}
            {% if item.url %}
              <a 
                href="{{ item.url }}" 
                {% if item.url | isExternalUrl %}target="_blank" rel="noopener noreferrer"{% endif %}
                class="hero-social-link p-2 rounded-lg border border-dotted border-base-300 hover:border-primary text-base-content/70 hover:text-base-content transition-colors flex items-center justify-center shrink-0"
                title="{{ item.platform | default('Social Profile') }}"
                aria-label="{{ item.platform | default('Social Profile') }}"
              >
                <i class="ph {{ item | socialIcon }} text-sm pointer-events-none"></i>
              </a>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>

    </div>

  </div>
</section>


<!-- =======================================================================
     02 // INFINITE SCROLL (GSAP) WITH PROGRAMMING LANGUAGES
     ======================================================================= -->
<section class="py-3 px-4 sm:px-8 border-b border-dotted border-base-300 overflow-hidden bg-base-200/20">
  <div class="marquee-container">
    <div id="gsap-marquee-track" class="marquee-track flex items-center gap-8 text-[11px] text-base-content/70 font-mono cursor-pointer">
      
      {% for lang in languages %}
        <span class="shrink-0 py-0.5 hover:text-base-content transition-colors select-none">
          {{ lang.name }}
        </span>
      {% endfor %}

      <!-- Duplicate items for seamless continuous looping -->
      {% for lang in languages %}
        <span class="shrink-0 py-0.5 hover:text-base-content transition-colors select-none">
          {{ lang.name }}
        </span>
      {% endfor %}

    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const initGSAP = () => {
        if (!window.gsap) {
          setTimeout(initGSAP, 100);
          return;
        }
        const track = document.getElementById('gsap-marquee-track');
        if (!track) return;

        const halfWidth = track.scrollWidth / 2;
        const tween = gsap.to(track, {
          x: -halfWidth,
          duration: 30,
          ease: "none",
          repeat: -1,
          modifiers: {
            x: gsap.utils.unitize(x => parseFloat(x) % halfWidth)
          }
        });

        track.addEventListener('mouseenter', () => tween.pause());
        track.addEventListener('mouseleave', () => tween.resume());
      };
      initGSAP();
    });
  </script>
</section>


<!-- =======================================================================
     03 // SELECTED PROJECTS (Work)
     ======================================================================= -->
<section id="projects" class="p-4 sm:p-8 border-b border-dotted border-base-300">
  
  <div class="flex items-center justify-between mb-4 sm:mb-5">
    <h2 class="font-heading text-lg sm:text-xl font-semibold text-base-content leading-none">
      Selected Work
    </h2>
    <a href="/projects/" class="text-xs text-base-content/50 hover:text-base-content font-mono flex items-center gap-1 group leading-none">
      <span class="text-scramble" data-scramble="View all">View all</span> <i class="ph ph-arrow-right text-[11px]"></i>
    </a>
  </div>

  <div class="space-y-3.5 sm:space-y-4">
    {% for project in collections.projects | limit(3) %}
      {% set projectUrl = project.url if (project.content and project.content.trim().length > 20) else (project.data.link | default(project.data.github | default(project.url))) %}
      {% set hasCaseStudy = project.content and project.content.trim().length > 20 %}
      <div 
        class="group relative block p-3.5 sm:p-4 rounded-xl border border-dotted border-base-300 bg-base-100 hover:border-primary hover:bg-base-200/30 transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <h3 class="font-medium text-xs sm:text-sm text-base-content group-hover:text-primary transition-colors leading-none">
              <a href="{{ projectUrl }}" {% if not hasCaseStudy and projectUrl | isExternalUrl %}target="_blank" rel="noopener noreferrer"{% endif %} class="after:absolute after:inset-0 focus-visible:outline-none">
                {{ project.data.title }}
              </a>
            </h3>
            <span class="text-[11px] font-mono text-base-content/40 leading-none">{{ project.data.year | default(project.date | htmlDateString) }}</span>
          </div>

          <p class="text-xs text-base-content/75 leading-relaxed font-sans">
            {{ project.data.description }}
          </p>
        </div>

        <div class="flex items-center justify-between gap-2 pt-3 mt-3 border-t border-dotted border-base-300 text-[11px] font-mono">
          <span class="text-base-content/50 truncate max-w-[130px] xs:max-w-[180px] sm:max-w-none leading-none">
            {{ (project.data.tags | filterTagList | join(" · ")) or "Engineering" }}
          </span>
          <div class="flex items-center gap-3 shrink-0 leading-none">
            {% if hasCaseStudy %}
              <a 
                href="{{ project.url }}" 
                class="relative z-10 font-medium text-primary group-hover:underline font-mono flex items-center gap-1 focus-visible:outline-2 focus-visible:outline-primary"
              >
                <span class="text-scramble" data-scramble="Case study">Case study</span> <i class="ph ph-arrow-right text-[11px]"></i>
              </a>
            {% elif project.data.link %}
              <a 
                href="{{ project.data.link }}" 
                target="_blank"
                rel="noopener noreferrer"
                class="relative z-10 font-medium text-primary group-hover:underline font-mono flex items-center gap-1 focus-visible:outline-2 focus-visible:outline-primary"
              >
                <span class="text-scramble" data-scramble="Demo">Demo</span> <i class="ph ph-arrow-right text-[11px]"></i>
              </a>
            {% endif %}
            {% if project.data.github %}
              <a 
                href="{{ project.data.github }}" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="relative z-10 opacity-70 hover:opacity-100 font-mono hover:underline flex items-center gap-0.5 focus-visible:outline-2 focus-visible:outline-primary"
                title="View source code on GitHub"
                aria-label="View {{ project.data.title }} source code on GitHub"
              >
                Code <i class="ph ph-arrow-up-right text-[11px]"></i>
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% else %}
      <p class="text-xs text-base-content/50 font-mono py-2">No projects published yet.</p>
    {% endfor %}
  </div>

</section>


<!-- =======================================================================
     05 // YOUTUBE VIDEOS (Featured by Creator)
     ======================================================================= -->
<section id="videos" class="p-4 sm:p-8 border-b border-dotted border-base-300">
  
  <div class="flex items-center justify-between mb-4 sm:mb-5">
    <div class="flex items-center gap-2">
      <h2 class="font-heading text-lg sm:text-xl font-semibold text-base-content leading-none">
        YouTube
      </h2>
      <span 
        id="yt-sub-count"
        class="yt-sub-count text-xs text-base-content/50 font-mono leading-none"
        data-channel-url="{{ site.youtubeChannel.url }}"
        data-channel-id="{{ site.youtubeChannel.channelId }}"
      >
        · {{ site.youtubeChannel.subscribers or 'Subscribers' }}
      </span>
    </div>
    <a href="{{ site.youtubeChannel.url }}" target="_blank" rel="noopener noreferrer" class="text-xs text-base-content/50 hover:text-base-content font-mono flex items-center gap-1 group leading-none">
      <span class="text-scramble" data-scramble="Channel">Channel</span> <i class="ph ph-arrow-right text-[11px]"></i>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4">
    {% for video in youtube | limit(2) %}
      <a 
        href="{{ video.url }}" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group block p-3 rounded-xl border border-dotted border-base-300 bg-base-100 hover:border-primary transition-colors"
      >
        <div class="relative aspect-video rounded-lg overflow-hidden bg-base-200 mb-2.5">
          <img 
            src="{{ video.thumbnail }}" 
            alt="{{ video.title }}" 
            class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
            loading="lazy"
          />
          <span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded bg-black/80 text-white text-[10px] font-mono">
            {{ video.duration }}
          </span>
        </div>

        <h3 class="font-medium text-xs sm:text-sm leading-snug group-hover:text-primary transition-colors line-clamp-2">
          {{ video.title }}
        </h3>

        <p class="text-[11px] text-base-content/50 font-mono mt-1.5">
          {{ video.views }}
        </p>
      </a>
    {% endfor %}
  </div>

  <!-- Client-side YouTube Subscriber Count Fetcher & Cache Manager -->
  <script>
    (function() {
      const subElements = document.querySelectorAll('.yt-sub-count, #yt-sub-count');
      if (!subElements.length) return;

      const firstEl = subElements[0];
      const channelUrl = firstEl.getAttribute('data-channel-url') || '{{ site.youtubeChannel.url }}';
      let channelId = firstEl.getAttribute('data-channel-id') || '{{ site.youtubeChannel.channelId }}';

      if (!channelId && channelUrl) {
        const match = channelUrl.match(/UC[\w-]{21,23}/);
        if (match) channelId = match[0];
      }

      const key = channelId || channelUrl || 'yt_default';
      const cacheKey = 'yt_sub_cache_' + key;
      const cacheTimeKey = 'yt_sub_time_' + key;
      const TTL = 4 * 60 * 60 * 1000; // 4 hours client-side cache

      function renderSubs(text) {
        if (!text) return;
        const clean = text.trim();
        const formatted = clean.startsWith('·') ? clean : ('· ' + clean);
        subElements.forEach(function(el) {
          el.textContent = formatted;
        });
      }

      // 1. Immediately apply cached subscriber count to prevent layout shift or waiting
      const cached = localStorage.getItem(cacheKey);
      const cachedTime = parseInt(localStorage.getItem(cacheTimeKey) || '0', 10);
      const isCacheValid = cached && (Date.now() - cachedTime < TTL);

      if (cached) {
        renderSubs(cached);
      }

      function formatCount(count) {
        if (!count) return null;
        if (typeof count === 'string' && count.toLowerCase().includes('sub')) {
          return count;
        }
        const num = Number(count);
        if (isNaN(num)) return count + ' subscribers';
        const formatted = new Intl.NumberFormat('en-US', {
          notation: 'compact',
          compactDisplay: 'short',
          maximumFractionDigits: 2
        }).format(num);
        return formatted + ' subscribers';
      }

      // 2. Fetch latest subscriber count in the background and update afterwards if needed
      async function updateSubscriberCount() {
        try {
          if (!channelId && channelUrl) {
            const cachedId = localStorage.getItem('yt_channel_id_' + channelUrl);
            if (cachedId) channelId = cachedId;
          }

          if (channelId) {
            const res = await fetch('https://api.socialcounts.org/youtube-live-subscriber-count/' + encodeURIComponent(channelId), {
              headers: { 'Accept': 'application/json' }
            });
            if (res.ok) {
              const data = await res.json();
              const rawCount = data?.counters?.api?.subscriberCount ?? data?.counters?.estimation?.subscriberCount;
              if (rawCount) {
                const formattedText = formatCount(rawCount);
                renderSubs(formattedText);
                localStorage.setItem(cacheKey, formattedText);
                localStorage.setItem(cacheTimeKey, Date.now().toString());
              }
            }
          }
        } catch (err) {
          // Non-blocking background catch: cached value remains displayed
        }
      }

      // If cache is missing or expired, fetch and update afterwards
      if (!isCacheValid) {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(updateSubscriberCount);
        } else {
          setTimeout(updateSubscriberCount, 200);
        }
      }
    })();
  </script>
</section>


<!-- =======================================================================
     06 // WRITING (Notes / Blog)
     ======================================================================= -->
<section id="blog" class="p-4 sm:p-8 border-b border-dotted border-base-300">
  
  <div class="flex items-center justify-between mb-4 sm:mb-5">
    <h2 class="font-heading text-lg sm:text-xl font-semibold text-base-content leading-none">
      Notes
    </h2>
    <a href="/blog/" class="text-xs text-base-content/50 hover:text-base-content font-mono flex items-center gap-1 group leading-none">
      <span class="text-scramble" data-scramble="All notes">All notes</span> <i class="ph ph-arrow-right text-[11px]"></i>
    </a>
  </div>

  <div class="space-y-3">
    {% for post in collections.posts | limit(3) %}
      <article>
        <a 
          href="{{ post.url }}" 
          class="group block p-3.5 rounded-xl border border-dotted border-base-300 bg-base-100 hover:border-primary hover:bg-base-200/30 transition-all cursor-pointer"
        >
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-xs sm:text-sm font-medium group-hover:text-primary transition-colors text-base-content truncate leading-none">
              {{ post.data.title }}
            </h3>
            <time datetime="{{ post.date | htmlDateString }}" class="text-[11px] text-base-content/40 font-mono shrink-0 leading-none">
              {{ post.date | readableDate }}
            </time>
          </div>
          {% if post.data.description %}
            <p class="text-xs text-base-content/70 leading-relaxed mt-1 line-clamp-2 font-sans">
              {{ post.data.description }}
            </p>
          {% endif %}
        </a>
      </article>
    {% else %}
      <p class="text-xs text-base-content/50 font-mono py-2">No notes published yet.</p>
    {% endfor %}
  </div>

</section>


<!-- =======================================================================
     07 // ART & PHOTOGRAPHY (Gallery)
     ======================================================================= -->
<section id="gallery" class="p-4 sm:p-8">
  
  <div class="flex items-center justify-between mb-4 sm:mb-5">
    <h2 class="font-heading text-lg sm:text-xl font-semibold text-base-content leading-none">
      Art & Photography
    </h2>
    <a href="/photos/" class="text-xs text-base-content/50 hover:text-base-content font-mono flex items-center gap-1 group leading-none">
      <span class="text-scramble" data-scramble="Gallery">Gallery</span> <i class="ph ph-arrow-right text-[11px]"></i>
    </a>
  </div>

  <div class="grid grid-cols-3 gap-2 sm:gap-3">
    {% for photo in photos | limit(3) %}
      <figure class="group">
        <div 
          class="aspect-square rounded-xl overflow-hidden bg-base-200 border border-dotted border-base-300 relative cursor-pointer"
          onclick="openLightbox({{ loop.index0 }})"
          role="button"
          tabindex="0"
          onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox({{ loop.index0 }});}"
          aria-label="View {{ photo.title }} in lightbox"
        >
          <img 
            src="{{ photo.image }}" 
            alt="{{ photo.title }}" 
            class="w-full h-full object-cover filter grayscale hover:grayscale-0 group-hover:scale-104 transition-all duration-300"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
            <span class="p-1.5 rounded-full bg-base-100/95 text-base-content shadow-md flex items-center justify-center">
              <i class="ph ph-magnifying-glass-plus text-sm"></i>
            </span>
          </div>
        </div>
      </figure>
    {% else %}
      <p class="text-xs text-base-content/50 font-mono py-4 col-span-full">No photos published yet.</p>
    {% endfor %}
  </div>

</section>

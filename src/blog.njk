---
layout: base.njk
title: Notes
permalink: /blog/index.html
---

<div class="p-4 sm:p-8 space-y-5 sm:space-y-6">
  
  <header class="pb-5 sm:pb-6 border-b border-dotted border-base-300">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <h1 class="font-heading text-2xl xs:text-3xl sm:text-4xl text-base-content font-bold tracking-tight">
          Notes
        </h1>
        <p class="text-xs sm:text-sm text-base-content/60 mt-1 font-sans">
          Thoughts, architecture breakdowns, and web development notes.
        </p>
      </div>

      <!-- Active Tag Filter Badge (Hidden by default, shown when ?tag=... is present) -->
      <div id="active-tag-filter" class="hidden items-center gap-2 self-start sm:self-auto font-mono text-xs">
        <span class="text-base-content/50">Tag:</span>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-base-200/70 border border-dotted border-base-300 text-base-content/85">
          <span class="text-primary/70 font-semibold">#</span>
          <span id="active-tag-name" class="font-medium"></span>
          <a href="/blog/" class="hover:text-error transition-colors ml-1 cursor-pointer flex items-center" title="Clear filter" aria-label="Clear tag filter">
            <i class="ph ph-x text-xs"></i>
          </a>
        </span>
      </div>
    </div>
  </header>

  <div id="posts-list" class="space-y-3.5 sm:space-y-4">
    {% for post in collections.posts %}
      <article data-tags="{{ (post.data.tags or []) | join(',') | lower }}">
        <a 
          href="{{ post.url }}" 
          class="group block p-3.5 sm:p-4 rounded-xl border border-dotted border-base-300 bg-base-100 hover:border-primary hover:bg-base-200/30 transition-all cursor-pointer space-y-2"
        >
          <div class="flex items-center justify-between gap-3 sm:gap-4">
            <h2 class="text-xs sm:text-sm font-medium text-base-content group-hover:text-primary transition-colors leading-none truncate">
              {{ post.data.title }}
            </h2>
            <time datetime="{{ post.date | htmlDateString }}" class="text-[11px] text-base-content/40 font-mono shrink-0 leading-none">
              {{ post.date | readableDate }}
            </time>
          </div>
          
          <p class="text-xs text-base-content/70 leading-relaxed line-clamp-2 font-sans">
            {{ post.data.description | default(post.templateContent | striptags | truncate(140)) }}
          </p>

          <div class="flex items-center justify-between gap-2 pt-2 border-t border-dotted border-base-300 text-[11px] font-mono">
            <span class="text-base-content/50 truncate max-w-[150px] sm:max-w-none leading-none">
              {{ (post.data.tags | filterTagList | join(" · ")) or "Architecture" }}
            </span>
            <span class="text-primary font-medium group-hover:underline shrink-0 flex items-center gap-1 leading-none">
              <span class="text-scramble" data-scramble="Read note">Read note</span> <i class="ph ph-arrow-right text-[11px]"></i>
            </span>
          </div>
        </a>
      </article>
    {% else %}
      <p class="text-xs text-base-content/50 font-mono py-4">No notes published yet.</p>
    {% endfor %}

    <!-- No Match State -->
    <div id="no-match-state" class="hidden p-6 rounded-xl border border-dotted border-base-300 text-center font-mono text-xs text-base-content/60 space-y-2">
      <p>No notes found matching this tag.</p>
      <a href="/blog/" class="text-primary hover:underline inline-flex items-center gap-1">
        <span>View all notes</span> <i class="ph ph-arrow-right text-[11px]"></i>
      </a>
    </div>
  </div>

</div>

<script>
  (function() {
    const urlParams = new URLSearchParams(window.location.search);
    const tagParam = urlParams.get('tag');
    const filterBar = document.getElementById('active-tag-filter');
    const tagNameSpan = document.getElementById('active-tag-name');
    const articles = document.querySelectorAll('#posts-list > article');
    const noMatch = document.getElementById('no-match-state');

    if (tagParam) {
      const cleanTag = tagParam.trim().toLowerCase();
      let matchCount = 0;
      articles.forEach(function(art) {
        const tags = (art.dataset.tags || '').split(',');
        if (tags.includes(cleanTag)) {
          art.style.display = '';
          matchCount++;
        } else {
          art.style.display = 'none';
        }
      });

      if (filterBar && tagNameSpan) {
        filterBar.classList.remove('hidden');
        filterBar.classList.add('flex');
        tagNameSpan.textContent = cleanTag;
      }

      if (matchCount === 0 && noMatch) {
        noMatch.classList.remove('hidden');
      }
    }
  })();
</script>

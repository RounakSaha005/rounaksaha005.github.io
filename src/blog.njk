---
layout: base.njk
title: Blog & Engineering Writing
permalink: /blog/index.html
---

<div class="relative py-16 sm:py-20 border-b border-base-200/80 overflow-hidden">
  <div class="absolute inset-0 grid-lines-bg opacity-25 grid-mask-fade pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="mb-12 pb-6 border-b border-base-200/80">
      <div class="text-xs font-mono text-primary font-bold tracking-wider mb-2">// 02 · ENGINEERING LOGS & ARTICLES</div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight">Engineering Blog</h1>
      <p class="text-lg opacity-80 mt-2 max-w-2xl">
        Reflections, architectural breakdowns, and tutorials on static-first design, edge systems, and modern CSS.
      </p>
    </div>

    <!-- Articles List -->
    <div class="space-y-6">
      {% for post in collections.posts | reverse %}
        <article class="crosshair-corner card bg-base-100 border border-base-300 shadow-sm hover:shadow-md hover:border-primary transition-all duration-200 rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div class="space-y-2 flex-1">
            <div class="flex items-center gap-3 text-xs font-mono opacity-60">
              <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
              <span>·</span>
              <span class="text-primary font-semibold">5 min read</span>
              <span>·</span>
              <span class="badge badge-xs badge-outline font-mono">Article</span>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold font-mono tracking-tight text-base-content hover:text-primary transition-colors">
              <a href="{{ post.url }}">{{ post.data.title }}</a>
            </h2>

            <p class="text-sm opacity-80 leading-relaxed max-w-2xl">
              {{ post.data.description | default(post.templateContent | striptags | truncate(160)) }}
            </p>

            <div class="flex flex-wrap gap-1.5 pt-2">
              {% for tag in post.data.tags %}
                {% if tag != "posts" %}
                  <span class="badge badge-xs badge-soft badge-primary font-mono">{{ tag }}</span>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <a href="{{ post.url }}" class="btn btn-primary btn-sm font-mono shrink-0">
            Read Article →
          </a>
        </article>
      {% else %}
        <div class="p-12 text-center border border-dashed border-base-300 rounded-2xl bg-base-100 font-mono">
          <p class="opacity-60 text-sm">No articles published yet. Check back soon!</p>
        </div>
      {% endfor %}
    </div>

    <!-- YouTube Companion Card -->
    <div class="mt-16 p-6 sm:p-8 rounded-2xl bg-base-200/50 border border-base-300 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-full bg-red-600 text-white flex items-center justify-center shrink-0 shadow-md">
          <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </div>
        <div>
          <h3 class="font-bold text-base">Prefer video walkthroughs?</h3>
          <p class="text-xs opacity-75 mt-0.5">Most of these articles have accompanying video tutorials on my YouTube channel.</p>
        </div>
      </div>
      <a href="{{ site.youtubeChannel.url }}" target="_blank" rel="noopener noreferrer" class="btn btn-error btn-sm font-mono text-white shrink-0">
        Watch on YouTube →
      </a>
    </div>

  </div>
</div>

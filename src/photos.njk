---
layout: base.njk
title: Art & Photography
permalink: /photos/index.html
---

<div class="p-4 sm:p-8 space-y-5 sm:space-y-6">
  
  <header class="pb-5 sm:pb-6 border-b border-dotted border-base-300">
    <h1 class="font-heading text-2xl xs:text-3xl sm:text-4xl text-base-content font-bold tracking-tight">
      Art & Photography
    </h1>
    <p class="text-xs sm:text-sm text-base-content/60 mt-1 font-sans">
      Visual journal: studio setups, hardware, and travels.
    </p>
  </header>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-4">
    {% for photo in photos %}
      <figure class="group">
        <div 
          class="aspect-square rounded-xl overflow-hidden bg-base-200 border border-dotted border-base-300 relative cursor-pointer"
          onclick="openLightbox({{ loop.index0 }})"
          role="button"
          tabindex="0"
          onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox({{ loop.index0 }});}"
          aria-label="View {{ photo.title }} in lightbox"
        >
          <img 
            src="{{ photo.image }}" 
            alt="{{ photo.title }}" 
            class="w-full h-full object-cover filter grayscale hover:grayscale-0 group-hover:scale-104 transition-all duration-300"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
            <span class="p-1.5 sm:p-2 rounded-full bg-base-100/95 text-base-content shadow-md flex items-center justify-center">
              <i class="ph ph-magnifying-glass-plus text-sm sm:text-base"></i>
            </span>
          </div>
        </div>
        <figcaption class="mt-1.5 text-[11px] text-base-content/60 truncate font-sans">
          {{ photo.title }}
        </figcaption>
      </figure>
    {% else %}
      <p class="text-xs text-base-content/50 font-mono py-8 col-span-full text-center">No photos published yet. Add photos in Pages CMS.</p>
    {% endfor %}
  </div>

</div>

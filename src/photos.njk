---
layout: base.njk
title: Photography & Developer Spaces
permalink: /photos/index.html
---

<div class="relative py-16 sm:py-20 border-b border-base-200/80 overflow-hidden">
  <div class="absolute inset-0 grid-lines-bg opacity-25 grid-mask-fade pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="mb-12 pb-6 border-b border-base-200/80">
      <div class="text-xs font-mono text-primary font-bold tracking-wider mb-2">// 06 · VISUAL ARCHIVE</div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight">Photography & Spaces</h1>
      <p class="text-lg opacity-80 mt-2 max-w-2xl">
        Capturing moments outside of terminal screens: developer setups, conference stages, hackathons, and travels.
      </p>
    </div>

    <!-- Photos Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for photo in photos %}
        <figure class="crosshair-corner card bg-base-100 border border-base-300 shadow-sm hover:shadow-lg transition-all duration-300 rounded-2xl overflow-hidden group">
          <div class="relative aspect-4/3 w-full overflow-hidden bg-base-200">
            <img 
              src="{{ photo.image }}" 
              alt="{{ photo.title }}" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter grayscale contrast-105 group-hover:grayscale-0"
              loading="lazy"
            />
            <div class="absolute top-3 left-3 badge badge-sm badge-neutral font-mono shadow-xs">
              {{ photo.category }}
            </div>
            <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded bg-black/80 text-white text-[11px] font-mono">
              {{ photo.location }} · {{ photo.date }}
            </div>
          </div>
          <figcaption class="p-4 sm:p-5 border-t border-base-200">
            <h3 class="font-bold text-sm tracking-tight text-base-content">{{ photo.title }}</h3>
            <p class="text-xs opacity-75 mt-1 font-mono leading-relaxed">{{ photo.description }}</p>
          </figcaption>
        </figure>
      {% endfor %}
    </div>

    <!-- Photography Equipment Box -->
    <div class="mt-16 p-6 sm:p-8 rounded-2xl bg-base-100 border border-base-300 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
      <div class="flex items-center gap-3">
        <span class="text-base text-primary">📷</span>
        <span>Shot on Sony A7IV · Prime 35mm f/1.4 GM & 24-70mm f/2.8 GM II</span>
      </div>
      <span class="opacity-60">Color Graded in Lightroom & DaVinci Resolve</span>
    </div>

  </div>
</div>

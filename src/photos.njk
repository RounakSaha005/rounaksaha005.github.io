---
layout: base.njk
title: Art & Photography
permalink: /photos/index.html
---

<div class="p-6 sm:p-8 space-y-6">
  
  <header class="pb-6 border-b border-dashed border-base-200/80">
    <h1 class="font-heading text-3xl sm:text-4xl text-base-content font-bold tracking-tight">
      Art & Photography
    </h1>
    <p class="text-xs sm:text-sm text-base-content/60 mt-1">
      Visual journal: studio setups, hardware, and travels.
    </p>
  </header>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
    {% for photo in photos %}
      <figure class="group">
        <div class="aspect-square rounded-xl overflow-hidden bg-base-200 border border-base-200/80">
          <img 
            src="{{ photo.image }}" 
            alt="{{ photo.title }}" 
            class="w-full h-full object-cover filter grayscale hover:grayscale-0 transition-all duration-300"
            loading="lazy"
          />
        </div>
        <figcaption class="mt-1.5 text-[11px] text-base-content/60 truncate font-sans">
          {{ photo.title }}
        </figcaption>
      </figure>
    {% endfor %}
  </div>

</div>

---
layout: base.njk
title: Photos
permalink: /photos/index.html
---

<div class="py-14 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6">
  
  <header class="mb-10 pb-6 border-b border-base-200/60">
    <h1 class="text-3xl font-bold tracking-tight text-base-content">Photos</h1>
    <p class="text-sm text-base-content/70 mt-1">
      Moments outside of code: setups, speaking, hackathons, and travels.
    </p>
  </header>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
    {% for photo in photos %}
      <figure class="group">
        <div class="aspect-4/3 rounded-xl overflow-hidden bg-base-200 border border-base-200/80">
          <img 
            src="{{ photo.image }}" 
            alt="{{ photo.title }}" 
            class="w-full h-full object-cover filter grayscale hover:grayscale-0 transition-all duration-300"
            loading="lazy"
          />
        </div>
        <figcaption class="mt-2 text-xs">
          <p class="font-medium text-base-content truncate">{{ photo.title }}</p>
          <p class="text-[11px] text-base-content/50 font-mono mt-0.5">{{ photo.location }} · {{ photo.date }}</p>
        </figcaption>
      </figure>
    {% endfor %}
  </div>

</div>

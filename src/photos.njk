---
layout: base.njk
title: Art & Photography
permalink: /photos/index.html
---

<div class="p-6 sm:p-8 space-y-6">
  
  <header class="pb-6 border-b border-dotted border-base-300">
    <h1 class="font-heading text-3xl sm:text-4xl text-base-content font-bold tracking-tight">
      Art & Photography
    </h1>
    <p class="text-xs sm:text-sm text-base-content/60 mt-1">
      Visual journal: studio setups, hardware, and travels.
    </p>
  </header>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
    {% for photo in photos %}
      <figure class="group">
        <div 
          class="aspect-square rounded-xl overflow-hidden bg-base-200 border border-dotted border-base-300 relative cursor-pointer"
          onclick="openLightbox({{ loop.index0 }})"
          role="button"
          tabindex="0"
          onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openLightbox({{ loop.index0 }});}"
          aria-label="View {{ photo.title }} in lightbox"
        >
          <img 
            src="{{ photo.image }}" 
            alt="{{ photo.title }}" 
            class="w-full h-full object-cover filter grayscale hover:grayscale-0 group-hover:scale-104 transition-all duration-300"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
            <span class="p-2 rounded-full bg-base-100/90 text-base-content border border-dotted border-base-300 shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
            </span>
          </div>
        </div>
        <figcaption class="mt-1.5 text-[11px] text-base-content/60 truncate font-sans">
          {{ photo.title }}
        </figcaption>
      </figure>
    {% endfor %}
  </div>

</div>

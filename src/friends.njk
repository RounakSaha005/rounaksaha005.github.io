---
layout: base.njk
title: Friends & Peers
permalink: /friends/index.html
---

<div class="p-6 sm:p-8 space-y-6">
  
  <header class="pb-6 border-b border-dashed border-base-200/80">
    <h1 class="font-['Newsreader',Georgia,serif] text-3xl sm:text-4xl text-base-content font-normal tracking-tight">
      Friends & Peers
    </h1>
    <p class="text-xs sm:text-sm text-base-content/60 mt-1">
      Engineers, creators, and designers whose craftsmanship I admire.
    </p>
  </header>

  <div class="space-y-3.5">
    {% for friend in friends %}
      <div class="p-4 rounded-xl border border-base-200/80 bg-base-100 flex items-start justify-between gap-4 hover:border-base-300 transition-colors">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-full overflow-hidden bg-base-200 shrink-0 border border-base-200">
            <img src="{{ friend.avatar }}" alt="{{ friend.name }}" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div>
            <h2 class="font-medium text-xs sm:text-sm text-base-content">{{ friend.name }}</h2>
            <p class="text-[11px] text-base-content/50">{{ friend.role }}</p>
            <p class="text-xs text-base-content/75 leading-relaxed mt-1">
              {{ friend.bio }}
            </p>
          </div>
        </div>

        <a href="{{ friend.url }}" target="_blank" rel="noopener noreferrer" class="text-xs text-primary hover:underline font-medium shrink-0 pt-1">
          Visit →
        </a>
      </div>
    {% endfor %}
  </div>

</div>

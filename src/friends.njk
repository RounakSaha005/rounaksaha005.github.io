---
layout: base.njk
title: Friends & Peers
permalink: /friends/index.html
---

<div class="p-4 sm:p-8 space-y-5 sm:space-y-6">
  
  <header class="pb-5 sm:pb-6 border-b border-dotted border-base-300">
    <h1 class="font-heading text-2xl xs:text-3xl sm:text-4xl text-base-content font-bold tracking-tight">
      Friends & Peers
    </h1>
    <p class="text-xs sm:text-sm text-base-content/60 mt-1 font-sans">
      Engineers, creators, and designers whose craftsmanship I admire.
    </p>
  </header>

  <div class="space-y-3 sm:space-y-3.5">
    {% for friend in friends %}
      <a 
        href="{{ friend.url }}" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="group block p-3.5 sm:p-4 rounded-xl border border-dotted border-base-300 bg-base-100 flex items-start justify-between gap-3 sm:gap-4 hover:border-primary hover:bg-base-200/30 transition-all cursor-pointer"
      >
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-full overflow-hidden bg-base-200 shrink-0 border border-base-300">
            <img src="{{ friend.avatar }}" alt="{{ friend.name }}" width="32" height="32" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div>
            <h2 class="font-medium text-xs sm:text-sm text-base-content group-hover:text-primary transition-colors">{{ friend.name }}</h2>
            <p class="text-[11px] text-base-content/50 font-mono">{{ friend.role }}</p>
            <p class="text-xs text-base-content/75 leading-relaxed mt-1 font-sans">
              {{ friend.bio }}
            </p>
          </div>
        </div>

        <span class="text-xs text-primary group-hover:underline font-mono font-medium shrink-0 pt-0.5 flex items-center gap-0.5">
          Visit <i class="ph ph-arrow-up-right text-[11px]"></i>
        </span>
      </a>
    {% endfor %}
  </div>

</div>

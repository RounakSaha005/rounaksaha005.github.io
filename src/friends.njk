---
layout: base.njk
title: Friends & Peer Links
permalink: /friends/index.html
---

<div class="relative py-16 sm:py-20 border-b border-base-200/80 overflow-hidden">
  <div class="absolute inset-0 grid-lines-bg opacity-25 grid-mask-fade pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="mb-12 pb-6 border-b border-base-200/80">
      <div class="text-xs font-mono text-primary font-bold tracking-wider mb-2">// 05 · COMMUNITY & BLOGROLL</div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight">Friends & Peers</h1>
      <p class="text-lg opacity-80 mt-2 max-w-2xl">
        A curated roll of talented developers, designers, open-source creators, and friends whose work inspires me daily.
      </p>
    </div>

    <!-- Friends Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for friend in friends %}
        <div class="crosshair-corner card bg-base-100 border border-base-300 shadow-sm hover:shadow-md hover:border-primary transition-all duration-200 rounded-2xl p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-4 mb-4">
              <div class="avatar">
                <div class="w-14 h-14 rounded-full ring-2 ring-base-300 overflow-hidden bg-base-200">
                  <img src="{{ friend.avatar }}" alt="{{ friend.name }}" loading="lazy" />
                </div>
              </div>
              <div>
                <h3 class="font-bold text-base text-base-content">{{ friend.name }}</h3>
                <p class="text-xs font-mono text-primary">{{ friend.role }}</p>
              </div>
            </div>

            <p class="text-xs sm:text-sm opacity-75 leading-relaxed">
              {{ friend.bio }}
            </p>

            <div class="flex flex-wrap gap-1.5 mt-4">
              {% for tag in friend.tags %}
                <span class="badge badge-xs badge-soft badge-neutral font-mono">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>

          <div class="pt-4 mt-6 border-t border-base-200/80">
            <a 
              href="{{ friend.url }}" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-outline btn-xs font-mono w-full"
            >
              Visit Website →
            </a>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Exchange Links Box -->
    <div class="mt-16 p-8 rounded-2xl bg-base-100 border border-base-300 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="font-bold text-lg font-mono">// Connect or Exchange Links</h3>
        <p class="text-xs sm:text-sm opacity-75 mt-1 max-w-xl">
          Are you a developer, creator, or writer? Drop an email or open a PR on GitHub to add your link to this blogroll.
        </p>
      </div>
      <a href="mailto:{{ site.author.email }}?subject=Friend%20Link%20Exchange" class="btn btn-primary btn-sm font-mono shrink-0">
        Email Me
      </a>
    </div>

  </div>
</div>

---
layout: base.njk
title: Friends & Peers
permalink: /friends/index.html
---

<div class="py-14 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6">
  
  <header class="mb-10 pb-6 border-b border-base-200/60">
    <h1 class="text-3xl font-bold tracking-tight text-base-content">Friends & Peers</h1>
    <p class="text-sm text-base-content/70 mt-1">
      Engineers, creators, and designers whose work inspires me.
    </p>
  </header>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {% for friend in friends %}
      <div class="p-5 rounded-xl border border-base-200/80 bg-base-100 flex flex-col justify-between hover:border-base-300 transition-colors">
        <div class="flex items-start gap-3.5 mb-3">
          <div class="w-10 h-10 rounded-full overflow-hidden bg-base-200 shrink-0 border border-base-200">
            <img src="{{ friend.avatar }}" alt="{{ friend.name }}" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div>
            <h2 class="font-semibold text-sm text-base-content">{{ friend.name }}</h2>
            <p class="text-xs text-base-content/60">{{ friend.role }}</p>
          </div>
        </div>

        <p class="text-xs text-base-content/75 leading-relaxed">
          {{ friend.bio }}
        </p>

        <div class="pt-3 mt-3 border-t border-base-200/50 text-xs">
          <a href="{{ friend.url }}" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline font-medium">
            Visit site →
          </a>
        </div>
      </div>
    {% endfor %}
  </div>

</div>

---
layout: base.njk
title: Work & Projects
permalink: /projects/index.html
---

<div class="p-6 sm:p-8 space-y-6">
  
  <header class="pb-6 border-b border-dotted border-base-300">
    <h1 class="font-heading text-3xl sm:text-4xl text-base-content font-bold tracking-tight">
      Work
    </h1>
    <p class="text-xs sm:text-sm text-base-content/60 mt-1">
      Selected production builds, libraries, and open source utilities.
    </p>
  </header>

  <div class="space-y-4">
    {% for project in projects %}
      <div class="p-4 rounded-xl border border-dotted border-base-300 bg-base-100 flex flex-col justify-between hover:border-primary transition-colors">
        <div>
          <div class="flex items-baseline justify-between gap-2 mb-1">
            <h2 class="text-sm font-medium text-base-content">
              {{ project.title }}
            </h2>
            <span class="text-[11px] font-mono text-base-content/40">{{ project.year }}</span>
          </div>

          <p class="text-xs text-base-content/75 leading-relaxed">
            {{ project.description }}
          </p>
        </div>

        <div class="flex items-center justify-between pt-3 mt-3 border-t border-dotted border-base-300 text-[11px] font-mono">
          <span class="text-base-content/50">{{ project.tags | join(" · ") }}</span>
          <div class="flex gap-3">
            {% if project.github %}
              <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" class="opacity-70 hover:opacity-100 font-mono">Code</a>
            {% endif %}
            {% if project.link %}
              <a href="{{ project.link }}" target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:underline font-mono">Demo →</a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

</div>

---
layout: base.njk
title: Work & Projects
permalink: /projects/index.html
---

<div class="p-4 sm:p-8 space-y-5 sm:space-y-6">
  
  <header class="pb-5 sm:pb-6 border-b border-dotted border-base-300">
    <h1 class="font-heading text-2xl xs:text-3xl sm:text-4xl text-base-content font-bold tracking-tight">
      Work
    </h1>
    <p class="text-xs sm:text-sm text-base-content/60 mt-1 font-sans">
      Selected production builds, libraries, and open source utilities.
    </p>
  </header>

  <div class="space-y-3.5 sm:space-y-4">
    {% for project in projects %}
      <a 
        href="{{ project.caseStudy | default(project.link) }}" 
        class="group block p-3.5 sm:p-4 rounded-xl border border-dotted border-base-300 bg-base-100 hover:border-primary hover:bg-base-200/30 transition-all cursor-pointer flex flex-col justify-between"
      >
        <div>
          <div class="flex items-baseline justify-between gap-2 mb-1">
            <h2 class="text-xs sm:text-sm font-medium text-base-content group-hover:text-primary transition-colors">
              {{ project.title }}
            </h2>
            <span class="text-[11px] font-mono text-base-content/40">{{ project.year }}</span>
          </div>

          <p class="text-xs text-base-content/75 leading-relaxed font-sans">
            {{ project.description }}
          </p>
        </div>

        <div class="flex items-center justify-between gap-2 pt-3 mt-3 border-t border-dotted border-base-300 text-[11px] font-mono">
          <span class="text-base-content/50 truncate max-w-[130px] xs:max-w-[180px] sm:max-w-none">{{ project.tags | join(" · ") }}</span>
          <div class="flex items-center gap-3 shrink-0">
            <span class="font-medium text-primary group-hover:underline font-mono">
              {% if project.caseStudy %}Case study →{% else %}Demo →{% endif %}
            </span>
            {% if project.github %}
              <span 
                onclick="event.preventDefault(); event.stopPropagation(); window.open('{{ project.github }}', '_blank', 'noopener,noreferrer');" 
                class="opacity-70 hover:opacity-100 font-mono hover:underline cursor-pointer"
                title="View source code"
              >
                Code ↗
              </span>
            {% endif %}
          </div>
        </div>
      </a>
    {% endfor %}
  </div>

</div>

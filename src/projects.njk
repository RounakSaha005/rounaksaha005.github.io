---
layout: base.njk
title: Projects & Open Source
permalink: /projects/index.html
---

<div class="relative py-16 sm:py-20 border-b border-base-200/80 overflow-hidden">
  <div class="absolute inset-0 grid-lines-bg opacity-25 grid-mask-fade pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header -->
    <div class="mb-12 pb-6 border-b border-base-200/80">
      <div class="text-xs font-mono text-primary font-bold tracking-wider mb-2">// 03 · WORK & EXPERIMENTS</div>
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight">Software Projects</h1>
      <p class="text-lg opacity-80 mt-2 max-w-2xl">
        A catalog of production applications, developer utilities, and open-source packages I've designed and engineered.
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {% for project in projects %}
        <article class="crosshair-corner card bg-base-100 border border-base-300 shadow-sm hover:shadow-lg hover:border-primary transition-all duration-300 rounded-2xl p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="badge badge-sm badge-outline font-mono text-xs">{{ project.status }}</span>
              <span class="text-xs font-mono opacity-60">{{ project.year }}</span>
            </div>

            <h2 class="text-2xl font-bold font-mono tracking-tight text-base-content">
              {{ project.title }}
            </h2>

            <p class="text-sm opacity-80 leading-relaxed mt-3">
              {{ project.description }}
            </p>

            <div class="flex flex-wrap gap-1.5 mt-5">
              {% for tag in project.tags %}
                <span class="badge badge-xs badge-soft badge-primary font-mono py-2.5 px-3">{{ tag }}</span>
              {% endfor %}
            </div>
          </div>

          <div class="flex items-center justify-between pt-6 mt-6 border-t border-base-200/80 font-mono text-xs">
            {% if project.github %}
              <a href="{{ project.github }}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm gap-1.5">
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                GitHub
              </a>
            {% else %}
              <span></span>
            {% endif %}

            {% if project.link %}
              <a href="{{ project.link }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
                View Project →
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- Open Source Note -->
    <div class="mt-16 p-6 rounded-2xl bg-base-100 border border-base-300 flex items-center justify-between text-xs font-mono">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
        <span>Looking for more experiments? Check out all my repositories on GitHub.</span>
      </div>
      <a href="{{ site.author.github }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-xs">
        github.com/rounaksaha →
      </a>
    </div>

  </div>
</div>
